description = "Visualise the assembly graph with Bandage (upstream BANDAGE_IMAGE, with the upstream GUNZIP_GFA step merged in, unicycler branch)"
when = "!config.skip_assembly && !config.skip_bandage && config.assemblers == 'unicycler'"
shell = """
mkdir -p assembly/unicycler/bandage
gzip -cd {input[0]} > {sample}.assembly.gfa
Bandage image {sample}.assembly.gfa {output[0]} --height 1000
Bandage image {sample}.assembly.gfa {output[1]} --height 1000
"""

