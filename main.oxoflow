cat {input[4]} {sample}.blastn.txt > {output[0]}
awk 'BEGIN{OFS="\\t";FS="\\t"}{print $0,$6/$16,$6/$15}' {sample}.blastn.txt | awk 'BEGIN{OFS="\\t";FS="\\t"} $16 > {config.min_contig_length} && $18 > {config.min_perc_contig_aligned} && $1 !~ /phage/ {print $0}' > tmp.out
cat {input[5]} tmp.out > {output[1]}
"""

