[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/abacas.yaml"

[[rules]]
name = "plasmidid"
input = ["assembly/spades/rnaviral/{sample}.scaffolds.fa.gz", "reference/genome.fa"]
output = ["assembly/spades/rnaviral/plasmidid/{sample}"]
description = "Reconstruct plasmid sequences from the assembly (upstream PLASMIDID, spades branch)"
# upstream PLASMIDID runs in ASSEMBLY_QC for every assembler; the port's
# assemblers key takes one name, so this rule serves the default spades
# branch. plasmidID downloads NO database — it only needs the reference
# fasta (-d) and the assembly scaffolds.
when = "!config.skip_assembly && !config.skip_plasmidid && config.assemblers == 'spades'"
shell = """
mkdir -p assembly/spades/rnaviral/plasmidid
gzip -cd {input[0]} > {sample}.scaffolds.fa
plasmidID \\
    -d {input[1]} \\
    -s {sample} \\
    -c {sample}.scaffolds.fa \\
    --only-reconstruct -C 47 -S 47 -i 60 --no-trim -k 0.80 \\
    -o .
mv NO_GROUP/{sample} assembly/spades/rnaviral/plasmidid/{sample}
rm -rf NO_GROUP
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/plasmidid.yaml"

# ---------------------------------------------------------------------------
# 11. MultiQC (upstream MULTIQC + multiqc_to_custom_csv.py)
# ---------------------------------------------------------------------------

[[rules]]
name = "multiqc"
input = []
expand_inputs = [
    { pattern = "{config.out_dir}/fastqc/raw/{sample}_1_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/raw/{sample}_2_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/trim/{sample}_1_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/trim/{sample}_2_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "fastp/{sample}.fastp.json", variables = { sample = "config.samples_list" } },
    { pattern = "kraken2/{sample}.kraken2.report.txt", variables = { sample = "config.samples_list" } },
    { pattern = "variants/bowtie2/log/{sample}.bowtie2.log", variables = { sample = "config.samples_list" } },
    { pattern = "variants/bowtie2/samtools_stats/{sample}.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    { pattern = "variants/bowtie2/samtools_stats/{sample}.ivar_trim.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    # upstream mixes BAM_MARKDUPLICATES_PICARD.out.flagstat into ch_multiqc_files
    { pattern = "variants/bowtie2/samtools_stats/{sample}.markduplicates.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    { pattern = "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.alignment_summary_metrics", variables = { sample = "config.samples_list" } },
    # mosdepth inputs mirror upstream ch_multiqc_files: the genome global.dist.txt
    # (distribution plots) plus the amplicon all_samples coverage tsv (heatmap).
    # The genome summary.txt is kept in addition (feeds the MultiQC mosdepth
    # General Stats table); the inert genome coverage.tsv and the amplicon
    # per-sample summary.txt are deliberately not fed.
    { pattern = "variants/bowtie2/mosdepth/genome/{sample}.mosdepth.mosdepth.summary.txt", variables = { sample = "config.samples_list" } },
    { pattern = "variants/bowtie2/mosdepth/genome/{sample}.mosdepth.mosdepth.global.dist.txt", variables = { sample = "config.samples_list" } },
    { pattern = "variants/bowtie2/mosdepth/amplicon/all_samples.mosdepth.coverage.tsv", variables = {} },
    { pattern = "variants/freyja/demix/{sample}.tsv", variables = { sample = "config.samples_list" } },
    { pattern = "variants/freyja/bootstrap/{sample}.lineages.csv", variables = { sample = "config.samples_list" } },
    { pattern = "variants/freyja/bootstrap/{sample}_summarized.csv", variables = { sample = "config.samples_list" } },
    { pattern = "variants/ivar/{sample}.variant_counts_mqc.tsv", variables = { sample = "config.samples_list" } },
    { pattern = "variants/ivar/{sample}.bcftools_stats.txt", variables = { sample = "config.samples_list" } },
    { pattern = "variants/ivar/snpeff/bcftools_stats/{sample}.snpeff.bcftools_stats.txt", variables = { sample = "config.samples_list" } },
    # snpeff -csvStats output; upstream mixes VARIANTS_IVAR.out.snpeff_csv into
    # ch_multiqc_files so MultiQC renders the SnpEff section
    { pattern = "variants/ivar/snpeff/{sample}.snpeff.csv", variables = { sample = "config.samples_list" } },
    { pattern = "variants/ivar/consensus/bcftools/pangolin/{sample}.pangolin.csv", variables = { sample = "config.samples_list" } },
    { pattern = "variants/ivar/consensus/bcftools/nextclade/{sample}.csv", variables = { sample = "config.samples_list" } },
    { pattern = "variants/ivar/consensus/bcftools/nextclade/nextclade_clade_mqc.tsv", variables = {} },
    { pattern = "assembly/cutadapt/log/{sample}.primer_trim.cutadapt.log", variables = { sample = "config.samples_list" } },
    { pattern = "assembly/spades/rnaviral/quast.spades", variables = {} },
    { pattern = "assembly/unicycler/quast.unicycler", variables = {} },
    { pattern = "assembly/minia/quast.minia", variables = {} },
    { pattern = "variants/ivar/consensus/bcftools/quast.consensus", variables = {} },
]
output = [
    "{config.out_dir}/multiqc/multiqc_report.html",
    "{config.out_dir}/multiqc/multiqc_data",
    # the bundled script defaults --out_prefix to "summary"
    # (live: the csvs landed as summary_* and the declared
    # prefix-less names never appeared)
    "{config.out_dir}/multiqc/summary_variants_metrics_mqc.csv",
    "{config.out_dir}/multiqc/summary_assembly_metrics_mqc.csv",
]
description = "Collate all reports with MultiQC (upstream MULTIQC + multiqc_to_custom_csv.py)"
shell = """
mkdir -p multiqc_work {config.out_dir}/multiqc
for f in {input}; do
    ln -sf "$PWD/$f" multiqc_work/
done
# Upstream's channel-level runtime filters are a documented deviation (the
# per-sample DROPS have no oxo-flow equivalent); their reporting half is
# ported here: the FAIL_READS (workflows/viralrecon.nf:262-294) and
# min_mapped_reads (viralrecon.nf:342-366) custom-content TSVs, created
# only when samples fail, with the same headers/rows as upstream
# (multiqcTsvFromList, lib/WorkflowCommons.groovy:51-61).
reads_before=""
for json in multiqc_work/*.fastp.json; do
    [ -f "$json" ] || continue
    after=$(python -c "import json,sys;print(json.load(open(sys.argv[1]))['summary']['after_filtering']['total_reads'])" "$json")
    if [ "$after" = "0" ]; then
        before=$(python -c "import json,sys;print(json.load(open(sys.argv[1]))['summary']['before_filtering']['total_reads'])" "$json")
        line=$(printf '%s\t%s' "$(basename "$json" .fastp.json)" "$before")
        reads_before="$reads_before$line\n"
    fi
done
if [ -n "$reads_before" ]; then
    printf 'Sample\tReads before trimming\n' > multiqc_work/fail_mapped_reads_mqc.tsv
    printf '%b' "$reads_before" >> multiqc_work/fail_mapped_reads_mqc.tsv
fi
mapped_samples=""
for flagstat in multiqc_work/*.sorted.bam.flagstat; do
    case "$flagstat" in
        # upstream gates on FASTQ_ALIGN_BOWTIE2.out.flagstat only, not the
        # ivar_trim / markduplicates variants
        *.ivar_trim.sorted.bam.flagstat|*.markduplicates.sorted.bam.flagstat) continue ;;
    esac
    n=$(awk '/ mapped \\(/ {print $1; exit}' "$flagstat")
    if [ -n "$n" ] && [ "$n" -le "{config.min_mapped_reads}" ]; then
        line=$(printf '%s\t%s' "$(basename "$flagstat" .sorted.bam.flagstat)" "$n")
        mapped_samples="$mapped_samples$line\n"
    fi
done
if [ -n "$mapped_samples" ]; then
    printf 'Sample\tMapped reads\n' > multiqc_work/fail_mapped_samples_mqc.tsv
    printf '%b' "$mapped_samples" >> multiqc_work/fail_mapped_samples_mqc.tsv
fi
args=""
[ -n "{config.multiqc_title}" ] && args="--title \\"{config.multiqc_title}\\""
# First pass: parse tool logs and dump module YAMLs
multiqc \\
    --force \\
    $args \\
    --config scripts/multiqc_config_illumina.yml \\
    multiqc_work/
# Parse YAML files dumped by MultiQC to obtain metrics
python scripts/multiqc_to_custom_csv.py --platform illumina
# Manually remove files that we don't want in the report
if grep -q ">skip_assembly<" multiqc_report.html; then
    rm -f *assembly_metrics_mqc.csv
fi
if grep -q ">skip_variants<" multiqc_report.html; then
    rm -f *variants_metrics_mqc.csv
fi
if [ "{config.platform}" = "illumina" ]; then
    rm -f variants/report.tsv
fi
# Second pass: final report (upstream ext.args2)
multiqc \\
    --force \\
    -e general_stats \\
    --ignore *nextclade_clade_mqc.tsv \\
    $args \\
    --config scripts/multiqc_config_illumina.yml \\
    multiqc_work/
mv multiqc_report.html {output[0]}
rm -rf {output[1]}
mv multiqc_data {output[1]}
mv summary_variants_metrics_mqc.csv {output[2]}
mv summary_assembly_metrics_mqc.csv {output[3]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/multiqc.yaml"
