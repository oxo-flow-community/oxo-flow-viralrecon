# oxo-flow port of nf-core/viralrecon 3.0.0 (default-parameters main path).
#
# Upstream: https://github.com/nf-core/viralrecon @ 3.0.0
#   (sha 395079f1d24dce731ac22e03d7a5e71f110103fc)
# Default path (illumina + amplicon): CAT_FASTQ -> FastQC(raw) -> fastp ->
#   FastQC(trimmed) -> Kraken2 host removal -> Bowtie2 align -> iVar primer
#   trim -> Picard CollectMultipleMetrics -> mosdepth (genome+amplicon) ->
#   Freyja (variants/demix/boot) -> iVar variant call -> snpEff/SnpSift ->
#   bcftools consensus -> Quast/Pangolin/Nextclade/base-density QC ->
#   Cutadapt primer trim -> SPAdes assembly -> Bandage/Blastn/Quast/ABACAS ->
#   variants long table -> MultiQC.
#
# Fidelity notes:
# - Commands mirror the upstream nf-core module scripts byte-for-byte under
#   default params (upstream `params.*` are reproduced as [config] keys with
#   identical defaults; process `ext.args` are baked into the shell).
# - Upstream `withLabel` resource profiles (cpus/memory/time) are baked into
#   [rules.resources]; envs/*.yaml carry the exact conda pins from the
#   upstream module environment.yml files.
# - Merges: processes that run back-to-back inside one upstream subworkflow
#   (e.g. SAMTOOLS_SORT+SAMTOOLS_INDEX+BAM_STATS_SAMTOOLS) become one rule
#   whose command runs them sequentially. Every merge is listed in the
#   README fidelity table.
# - The default path uses amplicon protocol + iVar variant calling + SPAdes
#   assembly. The non-default branches are ported as when-gated rules that
#   mirror the upstream params they toggle (all OFF by default exactly like
#   upstream): bcftools variant calling (variant_caller='bcftools'),
#   consensus with iVar (consensus_caller='ivar'), the metagenomic/wgs
#   protocol (protocol='metagenomic'; upstream 3.0.0 has no 'wgs' protocol
#   value; upstream derives variant_caller='bcftools' for non-amplicon runs
#   and the port mirrors that in the wgs rules' when conditions, so a
#   metagenomic run auto-runs the bcftools caller chain), the unicycler and
#   minia assemblers (assemblers='unicycler'/'minia'), Picard MarkDuplicates
#   (skip_markduplicates=false), plasmidID (skip_plasmidid=false) and the
#   network-download processes (KRAKEN2_BUILD when kraken2_db='', FREYJA_UPDATE
#   when a freyja db path is empty, PANGOLIN_UPDATEDATA when pango_database='').
#   Branch rules that consume the same canonical outputs as the default path
#   write to those same paths under mutually-exclusive gates (the engine
#   accepts this).
# - The nanopore platform branch (guppybasecaller, artic minion etc.) is not
#   ported: guppybasecaller is a commercial ONT tool and no nanopore fixture
#   exists; upstream workflows/nanopore are structurally distinct.
# - Runtime channel filters (fastp "reads after filtering" check,
#   min_mapped_reads gate, zero-variant-sample filter) have no oxo-flow DAG
#   equivalent: the per-sample DROPS are documented deviations, while the
#   reporting half (fail_mapped_reads_mqc.tsv / fail_mapped_samples_mqc.tsv)
#   is ported inside the multiqc rule.

[workflow]
name = "oxo-flow-viralrecon"
version = "1.0.0"
description = "Viral assembly and intrahost variant calling: FastQC, fastp trimming, Kraken2 host removal, Bowtie2 alignment, iVar primer trimming + variant calling, snpEff/SnpSift annotation, bcftools consensus, Pangolin/Nextclade lineage calling, SPAdes de novo assembly, MultiQC"
author = "oxo-flow-community"
sample_group_name = "cohort"

[config]
# --- Reference files (upstream --fasta / --gff / --primer_bed) ---
# The port expects uncompressed files at these paths. Set the *_ends_gz keys
# to true to run the upstream GUNZIP_* steps first (outputs land at the same
# fixed reference/ paths).
fasta = "reference/genome.fa"
gff = "reference/genome.gff"
primer_bed = "reference/primers.bed"
fasta_ends_gz = false
gff_ends_gz = false
primer_bed_ends_gz = false
# --- Kraken2 host-removal database (upstream --kraken2_db, tar.gz) ---
kraken2_db = "reference/kraken2_db.tar.gz"
# upstream params.kraken2_db_name — the library KRAKEN2_BUILD downloads when
# kraken2_db is left empty (gated rule kraken2_build)
kraken2_db_name = "human"
kraken2_variants_host_filter = false
kraken2_assembly_host_filter = true
# --- Nextclade dataset (upstream genome config for MN908947.3) ---
nextclade_dataset = ""
nextclade_dataset_name = "sars-cov-2"
nextclade_dataset_tag = "2024-10-17--16-48-48Z"
# --- Pangolin (upstream --pango_database; a directory. When left empty the
#     gated rules pangolin_updatedata + pangolin_run_updated download the
#     data directory instead, mirroring upstream PANGOLIN_UPDATEDATA.) ---
pango_database = "test/fixtures/refs/pangolin_db"
# --- Freyja (upstream --freyja_barcodes / --freyja_lineages. When either is
#     left empty the gated rules freyja_update + freyja_demix_updated /
#     freyja_boot_updated download and use the upstream DB instead.) ---
freyja_barcodes = "test/fixtures/refs/freyja_barcodes.csv"
# upstream params.freyja_db_name — where FREYJA_UPDATE writes its download
# (upstream default 'freyja_db'; the port points into reference/)
freyja_db_name = "reference/freyja_db"
# freyja's meta format is the curated_lineages JSON (buildLineageMap
# json.loads it — live: the CSV default died in freyja boot with
# JSONDecodeError); the CSV sibling is kept as the barcodes-side table
freyja_lineages = "test/fixtures/refs/freyja_lineages.json"
freyja_repeats = 100
freyja_depthcutoff = 0
# --- Input reads (upstream samplesheet) ---
# Directory holding raw/<sample>_R1.fastq.gz + raw/<sample>_R2.fastq.gz.
# The repo default ships the tiny test fixtures; point this at your data.
raw_dir = "test/fixtures/raw"
out_dir = "results"
# --- Platform / protocol ---
platform = "illumina"
protocol = "amplicon"
# --- Variant calling (upstream params.variant_caller defaults to 'ivar' for
#     the amplicon protocol and 'bcftools' otherwise; both branches are
#     ported as when-gated rules). The metagenomic branch auto-runs the
#     bcftools caller regardless of this key — upstream derives
#     variant_caller in nextflow.config (params.variant_caller = protocol ==
#     'metagenomic' ? 'bcftools' : 'ivar'), and the port mirrors that
#     derivation in the wgs rules' when conditions, so a metagenomic run
#     needs no extra --arg ---
variant_caller = "ivar"
# --- Consensus caller (upstream params.consensus_caller; both the bcftools
#     and ivar branches are ported as when-gated rules) ---
consensus_caller = "bcftools"
# upstream params.min_mapped_reads — the per-sample channel DROP is a
# documented runtime-filter deviation (no dynamic DAG); the reporting half
# (fail_mapped_samples_mqc.tsv in the MultiQC data) is ported inside the
# multiqc rule
min_mapped_reads = 1000
ivar_trim_noprimer = false
ivar_trim_offset = ""
# upstream params.save_mpileup — when true, call_variants_ivar tees the
# samtools mpileup stream to variants/ivar/{sample}.mpileup (off by
# default, exactly like upstream; the port emits an empty placeholder when
# false so the declared output stays present)
save_mpileup = false
# upstream params.save_unaligned — NOT ported as a gate: the Kraken2
# unclassified reads feed the assembly branch (upstream channel wiring),
# so they always land in results/kraken2/ — the flag is effectively always
# on in the port (benign over-emission vs upstream's default publish)
save_unaligned = false
# upstream params.save_trimmed_fail — when true, fastp keeps the
# reads that failed filtering (--failed_out + --unpaired1/2); off by
# default, exactly like upstream (empty placeholders when false)
save_trimmed_fail = false
# --- Consensus QC ---
min_contig_length = 200
min_perc_contig_aligned = 0.7
# --- Assembly (upstream params.assemblers may list several assemblers; the
#     port's when-language has no 'in' operator, so assemblers takes ONE
#     name and the unicycler/minia branches are gated on equality:
#     assemblers='spades' | 'unicycler' | 'minia'. Comma-separated lists are
#     a documented deviation.) ---
assemblers = "spades"
spades_mode = "rnaviral"
# --- Primer trimming for assembly ---
primer_left_suffix = "_LEFT"
primer_right_suffix = "_RIGHT"
threeprime_adapters = false
# --- Skip flags (identical defaults to upstream params) ---
skip_fastqc = false
skip_fastp = false
skip_kraken2 = false
skip_variants = false
skip_picard_metrics = false
skip_markduplicates = true
skip_mosdepth = false
skip_ivar_trim = false
skip_freyja = false
skip_freyja_boot = false
skip_consensus = false
skip_variants_quast = false
skip_pangolin = false
skip_nextclade = false
skip_snpeff = false
skip_variants_long_table = false
skip_consensus_plots = false
skip_assembly = false
skip_assembly_quast = false
skip_abacas = false
skip_bandage = false
skip_blast = false
skip_cutadapt = false
skip_noninternal_primers = false
skip_plasmidid = true
# upstream params.filter_duplicates (default false) — passed to
# PICARD_MARKDUPLICATES as REMOVE_DUPLICATES=true when set
filter_duplicates = false
# --- Additional annotation (upstream params.additional_annotation; empty =
#     off. A GFF/GTF to annotate the variants with in addition to the main
#     reference annotation, run through snpEff + SnpSift + the variants long
#     table. .gz files are gunzipped by build_snpeff_db_additional.) ---
additional_annotation = ""
# --- MultiQC ---
multiqc_title = ""

[[sample_groups]]
name = "cohort"
samples = ["S1", "S2"]

# ---------------------------------------------------------------------------
# 1. Reference preparation (upstream PREPARE_GENOME_ILLUMINA subworkflow:
#    GUNZIP_* / UNTAR_* / CUSTOM_GETCHROMSIZES / COLLAPSE_PRIMERS /
#    BEDTOOLS_GETFASTA / BOWTIE2_BUILD / NEXTCLADE_DATASETGET /
#    BLAST_MAKEBLASTDB / SNPEFF_BUILD)
# ---------------------------------------------------------------------------

[[rules]]
name = "gunzip_fasta"
input = ["{config.fasta}"]
output = ["reference/genome.fa"]
description = "Uncompress the reference FASTA (upstream GUNZIP_FASTA)"
when = "config.fasta_ends_gz"
shell = """
gzip -cd {input[0]} > {output[0]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/coreutils.yaml"

[[rules]]
name = "gunzip_gff"
input = ["{config.gff}"]
output = ["reference/genome.gff"]
description = "Uncompress the GFF annotation (upstream GUNZIP_GFF)"
when = "config.gff_ends_gz"
shell = """
gzip -cd {input[0]} > {output[0]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/coreutils.yaml"

[[rules]]
name = "gunzip_primer_bed"
input = ["{config.primer_bed}"]
output = ["reference/primers.bed"]
description = "Uncompress the primer BED file (upstream GUNZIP_PRIMER_BED)"
when = "config.primer_bed_ends_gz"
shell = """
gzip -cd {input[0]} > {output[0]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/coreutils.yaml"

[[rules]]
name = "prepare_genome"
input = ["reference/genome.fa"]
output = ["reference/genome.fa.fai", "reference/genome.sizes"]
description = "Index the reference and create the chromosome sizes file (upstream CUSTOM_GETCHROMSIZES)"
shell = """
samtools faidx {input[0]}
cut -f 1,2 {input[0]}.fai > {output[1]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "untar_kraken2_db"
input = ["{config.kraken2_db}"]
output = ["reference/kraken2_db"]
description = "Extract the Kraken2 database tarball (upstream UNTAR_KRAKEN2_DB)"
when = "!config.skip_kraken2 && config.kraken2_db != ''"
shell = """
mkdir -p reference/kraken2_db
# --no-same-owner = upstream UNTAR ext.args2 (applied to all PREPARE_GENOME
# UNTAR_* processes); matters when extracting as root from a non-root tarball
if [[ $(tar -taf {input[0]} | grep -o -P "^.*?\\/" | uniq | wc -l) -eq 1 ]]; then
    tar -C reference/kraken2_db --no-same-owner --strip-components 1 -xavf {input[0]}
else
    tar -C reference/kraken2_db --no-same-owner -xavf {input[0]}
fi
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/coreutils.yaml"

[[rules]]
name = "kraken2_build"
input = []
output = ["reference/kraken2_db"]
description = "Download taxonomy and build the Kraken2 database (upstream KRAKEN2_BUILD, process_high label)"
# upstream runs KRAKEN2_BUILD when !skip_kraken2 && !kraken2_db; the built
# db lands on the same canonical reference/kraken2_db path the untar rule
# writes to, so the kraken2 rule needs no changes (mutually-exclusive gates)
when = "!config.skip_kraken2 && config.kraken2_db == ''"
shell = """
# network download; the upstream module builds into ./kraken2_db, the port
# builds straight into the canonical reference/kraken2_db dir instead
mkdir -p reference/kraken2_db
kraken2-build --db reference/kraken2_db --threads {threads} --download-taxonomy
kraken2-build --db reference/kraken2_db --threads {threads} --download-library {config.kraken2_db_name}
kraken2-build --db reference/kraken2_db --threads {threads} --build
"""

[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

[rules.environment]
conda = "envs/kraken2_build.yaml"

[[rules]]
name = "collapse_primers"
input = ["reference/primers.bed"]
output = ["reference/primers.collapsed.bed"]
description = "Collapse primer pairs into amplicon intervals (upstream COLLAPSE_PRIMERS, process_medium label)"
when = "config.protocol == 'amplicon' && !config.skip_variants && !config.skip_mosdepth"
shell = """
python scripts/collapse_primer_bed.py \\
    --left_primer_suffix {config.primer_left_suffix} \\
    --right_primer_suffix {config.primer_right_suffix} \\
    {input[0]} \\
    {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/python.yaml"

[[rules]]
name = "get_primer_fasta"
input = ["reference/primers.bed", "reference/genome.fa"]
output = ["reference/primers.fa"]
description = "Extract primer sequences from the reference (upstream BEDTOOLS_GETFASTA)"
when = "config.protocol == 'amplicon' && !config.skip_assembly && !config.skip_cutadapt"
shell = """
bedtools getfasta -s -nameOnly -fi {input[1]} -bed {input[0]} -fo {output[0]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/bedtools.yaml"

[[rules]]
name = "build_bowtie2_index"
input = ["reference/genome.fa"]
output = [
    "reference/bowtie2/genome.fa.1.bt2",
    "reference/bowtie2/genome.fa.2.bt2",
    "reference/bowtie2/genome.fa.3.bt2",
    "reference/bowtie2/genome.fa.4.bt2",
    "reference/bowtie2/genome.fa.rev.1.bt2",
    "reference/bowtie2/genome.fa.rev.2.bt2",
]
description = "Build the Bowtie2 index from the reference (upstream BOWTIE2_BUILD, process_high label)"
when = "!config.skip_variants"
shell = """
mkdir -p reference/bowtie2
bowtie2-build --seed 1 --threads {threads} {input[0]} reference/bowtie2/genome.fa
"""

[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

[rules.environment]
conda = "envs/bowtie2.yaml"

[[rules]]
name = "get_nextclade_dataset"
input = ["reference/genome.fa"]
output = ["reference/nextclade_db"]
description = "Download the Nextclade dataset (upstream NEXTCLADE_DATASETGET)"
when = "!config.skip_consensus && !config.skip_nextclade && config.nextclade_dataset == ''"
shell = """
nextclade dataset get \\
    --name {config.nextclade_dataset_name} \\
    --tag {config.nextclade_dataset_tag} \\
    --output-dir {output[0]}
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/nextclade.yaml"

[[rules]]
name = "make_blast_db"
input = ["reference/genome.fa"]
output = [
    "reference/blastdb/genome.fa.nin",
    "reference/blastdb/genome.fa.nsq",
    "reference/blastdb/genome.fa.nhr",
]
description = "Build the BLAST nucleotide database from the reference (upstream BLAST_MAKEBLASTDB)"
when = "!config.skip_assembly && !config.skip_blast"
shell = """
mkdir -p reference/blastdb
makeblastdb \\
    -in {input[0]} \\
    -out reference/blastdb/genome.fa \\
    -parse_seqids -dbtype nucl
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/blast.yaml"

[[rules]]
name = "build_snpeff_db"
input = ["reference/genome.fa", "reference/genome.gff"]
output = ["reference/snpeff_db", "reference/snpeff.config"]
description = "Build the snpEff database from the reference (upstream SNPEFF_BUILD)"
when = "!config.skip_variants && !config.skip_snpeff"
shell = """
mkdir -p reference/snpeff_db/genomes/ reference/snpeff_db/genome/
ln -sf ../../genome.fa reference/snpeff_db/genomes/genome.fa
ln -sf ../../genome.gff reference/snpeff_db/genome/genes.gff
echo "genome.genome : genome" > reference/snpeff.config
# run from reference/ so -config/-dataDir resolve exactly like the
# upstream SNPEFF_BUILD (config dir = cwd, no path doubling)
cd reference
snpEff \\
    -Xmx{effective_memory_mb}m \\
    build \\
    -config snpeff.config \\
    -dataDir ./snpeff_db \\
    -gff3 \\
    -v \\
    genome
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/snpeff.yaml"

# ---------------------------------------------------------------------------
# 2. Read QC (upstream CAT_FASTQ -> FASTQ_TRIM_FASTP_FASTQC subworkflow)
# ---------------------------------------------------------------------------

[[rules]]
name = "cat_fastq"
input = ["{config.raw_dir}/{sample}_R1.fastq.gz", "{config.raw_dir}/{sample}_R2.fastq.gz"]
output = ["fastp/{sample}_1.fastq.gz", "fastp/{sample}_2.fastq.gz"]
description = "Concatenate per-sample FastQ files (upstream CAT_FASTQ)"
shell = """
cat {input[0]} > {output[0]}
cat {input[1]} > {output[1]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/coreutils.yaml"

[[rules]]
name = "fastqc_raw"
input = ["{config.raw_dir}/{sample}_R1.fastq.gz", "{config.raw_dir}/{sample}_R2.fastq.gz"]
output = [
    "{config.out_dir}/fastqc/raw/{sample}_1_fastqc.html",
    "{config.out_dir}/fastqc/raw/{sample}_2_fastqc.html",
    "{config.out_dir}/fastqc/raw/{sample}_1_fastqc.zip",
    "{config.out_dir}/fastqc/raw/{sample}_2_fastqc.zip",
]
description = "FastQC on the raw reads (upstream FASTQC_RAW)"
when = "!config.skip_fastqc"
shell = """
mkdir -p {config.out_dir}/fastqc/raw
# Upstream symlinks the reads to <sample>_{1,2}.fastq.gz before running
# FastQC (nf-core fastqc module), so FastQC output names ({sample}_{1,2}_fastqc.*)
# match the declared outputs instead of the raw basenames
[ ! -f  {sample}_1.fastq.gz ] && ln -sf {input[0]} {sample}_1.fastq.gz
[ ! -f  {sample}_2.fastq.gz ] && ln -sf {input[1]} {sample}_2.fastq.gz
fastqc \\
    --quiet \\
    --threads {threads} \\
    --memory 6144 \\
    {sample}_1.fastq.gz \\
    {sample}_2.fastq.gz
mv {sample}_1_fastqc.html {output[0]}
mv {sample}_2_fastqc.html {output[1]}
mv {sample}_1_fastqc.zip {output[2]}
mv {sample}_2_fastqc.zip {output[3]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/fastqc.yaml"

[[rules]]
name = "fastp"
input = ["fastp/{sample}_1.fastq.gz", "fastp/{sample}_2.fastq.gz"]
output = [
    "fastp/{sample}_1.fastp.fastq.gz",
    "fastp/{sample}_2.fastp.fastq.gz",
    "fastp/{sample}.fastp.json",
    "fastp/{sample}.fastp.html",
    "fastp/log/{sample}.fastp.log",
    "fastp/{sample}.paired.fail.fastq.gz",
    "fastp/{sample}_1.fail.fastq.gz",
    "fastp/{sample}_2.fail.fastq.gz",
]
description = "Adapter trimming with fastp (upstream FASTP, ext.args verbatim)"
when = "!config.skip_fastp"
shell = """
mkdir -p fastp fastp/log
# Upstream symlinks the input reads to <prefix>_1/2.fastq.gz before trimming
[ ! -f  {sample}_1.fastq.gz ] && ln -sf {input[0]} {sample}_1.fastq.gz
[ ! -f  {sample}_2.fastq.gz ] && ln -sf {input[1]} {sample}_2.fastq.gz
# upstream params.save_trimmed_fail: --failed_out keeps reads that failed
# filtering (paired) plus the unpaired mates; off by default (empty
# placeholders keep the declared outputs present)
if [ "{config.save_trimmed_fail}" = "true" ]; then
    fail_args="--failed_out {output[5]} --unpaired1 {output[6]} --unpaired2 {output[7]}"
else
    gzip -c /dev/null > {output[5]}
    gzip -c /dev/null > {output[6]}
    gzip -c /dev/null > {output[7]}
    fail_args=""
fi
fastp \\
    --in1 {sample}_1.fastq.gz \\
    --in2 {sample}_2.fastq.gz \\
    --out1 {output[0]} \\
    --out2 {output[1]} \\
    --json {output[2]} \\
    --html {output[3]} \\
    $fail_args \\
    --thread {threads} \\
    --detect_adapter_for_pe \\
    --cut_front --cut_tail --trim_poly_x --cut_mean_quality 30 \\
    --qualified_quality_phred 30 --unqualified_percent_limit 10 \\
    --length_required 50 \\
    2>| >(tee {output[4]} >&2)
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/fastp.yaml"

[[rules]]
name = "fastqc_trim"
input = ["fastp/{sample}_1.fastp.fastq.gz", "fastp/{sample}_2.fastp.fastq.gz"]
output = [
    "{config.out_dir}/fastqc/trim/{sample}_1_fastqc.html",
    "{config.out_dir}/fastqc/trim/{sample}_2_fastqc.html",
    "{config.out_dir}/fastqc/trim/{sample}_1_fastqc.zip",
    "{config.out_dir}/fastqc/trim/{sample}_2_fastqc.zip",
]
description = "FastQC on the trimmed reads (upstream FASTQC_TRIM)"
when = "!config.skip_fastp && !config.skip_fastqc"
shell = """
mkdir -p {config.out_dir}/fastqc/trim
# Upstream symlinks the trimmed reads to <sample>_{1,2}.fastq.gz before
# running FastQC, so FastQC output names ({sample}_{1,2}_fastqc.*) match the
# declared outputs instead of the fastp basenames
[ ! -f  {sample}_1.fastq.gz ] && ln -sf {input[0]} {sample}_1.fastq.gz
[ ! -f  {sample}_2.fastq.gz ] && ln -sf {input[1]} {sample}_2.fastq.gz
fastqc \\
    --quiet \\
    --threads {threads} \\
    --memory 6144 \\
    {sample}_1.fastq.gz \\
    {sample}_2.fastq.gz
mv {sample}_1_fastqc.html {output[0]}
mv {sample}_2_fastqc.html {output[1]}
mv {sample}_1_fastqc.zip {output[2]}
mv {sample}_2_fastqc.zip {output[3]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/fastqc.yaml"

# ---------------------------------------------------------------------------
# 3. Host removal and alignment (upstream KRAKEN2_KRAKEN2 ->
#    FASTQ_ALIGN_BOWTIE2 subworkflow)
# ---------------------------------------------------------------------------

[[rules]]
name = "kraken2"
input = ["fastp/{sample}_1.fastp.fastq.gz", "fastp/{sample}_2.fastp.fastq.gz", "reference/kraken2_db"]
output = [
    "kraken2/{sample}.kraken2.report.txt",
    "kraken2/{sample}.unclassified_1.fastq.gz",
    "kraken2/{sample}.unclassified_2.fastq.gz",
]
description = "Classify and filter host reads with Kraken2 (upstream KRAKEN2_KRAKEN2)"
when = "!config.skip_kraken2"
depends_on = ["untar_kraken2_db"]
shell = """
mkdir -p kraken2
kraken2 \\
    --db {input[2]} \\
    --threads {threads} \\
    --report {output[0]} \\
    --gzip-compressed \\
    --unclassified-out {sample}.unclassified#.fastq \\
    --classified-out {sample}.classified#.fastq \\
    --output /dev/null \\
    --paired \\
    --report-zero-counts \\
    {input[0]} \\
    {input[1]}
# kraken2 substitutes the # itself when writing; the shell cannot
# (live: pigz got the literal-name and skipped everything, then the
# mv died — kraken2 had written classified_1/2 and unclassified_1/2)
pigz -p {threads} {sample}.classified_1.fastq {sample}.classified_2.fastq {sample}.unclassified_1.fastq {sample}.unclassified_2.fastq
mv {sample}.unclassified_1.fastq.gz {output[1]}
mv {sample}.unclassified_2.fastq.gz {output[2]}
"""

[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

[rules.environment]
conda = "envs/kraken2.yaml"

[[rules]]
name = "align_bowtie2"
input = [
    "fastp/{sample}_1.fastp.fastq.gz",
    "fastp/{sample}_2.fastp.fastq.gz",
    "reference/bowtie2/genome.fa.1.bt2",
    "reference/bowtie2/genome.fa.2.bt2",
    "reference/bowtie2/genome.fa.3.bt2",
    "reference/bowtie2/genome.fa.4.bt2",
    "reference/bowtie2/genome.fa.rev.1.bt2",
    "reference/bowtie2/genome.fa.rev.2.bt2",
]
output = [
    "variants/bowtie2/{sample}.bam",
    "variants/bowtie2/log/{sample}.bowtie2.log",
]
description = "Map reads to the reference with Bowtie2 and filter unmapped reads (upstream BOWTIE2_ALIGN)"
when = "!config.skip_variants"
shell = """
mkdir -p variants/bowtie2 variants/bowtie2/log
INDEX=`find -L reference/bowtie2 -name "*.rev.1.bt2" | sed "s/\\.rev.1.bt2$//"`
[ -z "$INDEX" ] && INDEX=`find -L reference/bowtie2 -name "*.rev.1.bt2l" | sed "s/\\.rev.1.bt2l$//"`
[ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1
bowtie2 \\
    -x $INDEX \\
    -1 {input[0]} -2 {input[1]} \\
    --threads {threads} \\
    --local --very-sensitive-local --seed 1 \\
    2>| >(tee {output[1]} >&2) \\
    | samtools view -F4 -bh --threads {threads} -o {output[0]} -
"""

[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

[rules.environment]
conda = "envs/bowtie2.yaml"

[[rules]]
name = "bam_sort_index"
input = ["variants/bowtie2/{sample}.bam"]
output = [
    "variants/bowtie2/{sample}.sorted.bam",
    "variants/bowtie2/{sample}.sorted.bam.bai",
    "variants/bowtie2/samtools_stats/{sample}.sorted.bam.stats",
    "variants/bowtie2/samtools_stats/{sample}.sorted.bam.flagstat",
    "variants/bowtie2/samtools_stats/{sample}.sorted.bam.idxstats",
]
description = "Sort, index and collect stats for the aligned BAM (upstream SAMTOOLS_SORT + SAMTOOLS_INDEX + BAM_STATS_SAMTOOLS)"
when = "!config.skip_variants"
shell = """
mkdir -p variants/bowtie2/samtools_stats
samtools sort \\
    -T {sample}.sorted \\
    --threads {threads} \\
    -o {output[0]} \\
    {input[0]}
samtools index -@ {threads} {output[0]}
samtools stats --threads {threads} {output[0]} > {output[2]}
samtools flagstat --threads {threads} {output[0]} > {output[3]}
samtools idxstats --threads {threads} {output[0]} > {output[4]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/samtools.yaml"

# ---------------------------------------------------------------------------
# 4. Primer trimming (upstream BAM_TRIM_PRIMERS_IVAR subworkflow, amplicon)
# ---------------------------------------------------------------------------

[[rules]]
name = "ivar_trim"
input = ["variants/bowtie2/{sample}.sorted.bam", "reference/primers.bed"]
output = [
    "variants/bowtie2/{sample}.ivar_trim.bam",
    "variants/bowtie2/log/{sample}.ivar_trim.ivar.log",
]
description = "Trim primer sequences from the aligned BAM with iVar (upstream IVAR_TRIM)"
when = "!config.skip_variants && !config.skip_ivar_trim && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/bowtie2/log
# Upstream ext.args: -m 30 -q 20 [-e] [-x offset]
ivar_args="-m 30 -q 20"
[ "{config.ivar_trim_noprimer}" = "false" ] && ivar_args="$ivar_args -e"
[ -n "{config.ivar_trim_offset}" ] && ivar_args="$ivar_args -x {config.ivar_trim_offset}"
ivar trim \\
    $ivar_args \\
    -i {input[0]} \\
    -b {input[1]} \\
    -p {sample}.ivar_trim \\
    > {output[1]}
mv {sample}.ivar_trim.bam {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/ivar.yaml"

[[rules]]
name = "bam_sort_index_trimmed"
input = ["variants/bowtie2/{sample}.ivar_trim.bam"]
output = [
    "variants/bowtie2/{sample}.ivar_trim.sorted.bam",
    "variants/bowtie2/{sample}.ivar_trim.sorted.bam.bai",
    "variants/bowtie2/samtools_stats/{sample}.ivar_trim.sorted.bam.stats",
    "variants/bowtie2/samtools_stats/{sample}.ivar_trim.sorted.bam.flagstat",
    "variants/bowtie2/samtools_stats/{sample}.ivar_trim.sorted.bam.idxstats",
]
description = "Sort, index and collect stats for the primer-trimmed BAM (upstream BAM_SORT_STATS_SAMTOOLS)"
when = "!config.skip_variants && !config.skip_ivar_trim && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/bowtie2/samtools_stats
samtools sort \\
    -T {sample}.ivar_trim.sorted \\
    --threads {threads} \\
    -o {output[0]} \\
    {input[0]}
samtools index -@ {threads} {output[0]}
samtools stats --threads {threads} {output[0]} > {output[2]}
samtools flagstat --threads {threads} {output[0]} > {output[3]}
samtools idxstats --threads {threads} {output[0]} > {output[4]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "markduplicates"
input = ["variants/bowtie2/{sample}.ivar_trim.sorted.bam", "reference/genome.fa"]
output = [
    "variants/bowtie2/{sample}.markduplicates.sorted.bam",
    "variants/bowtie2/{sample}.markduplicates.sorted.bam.bai",
    "variants/bowtie2/samtools_stats/{sample}.markduplicates.sorted.bam.stats",
    "variants/bowtie2/samtools_stats/{sample}.markduplicates.sorted.bam.flagstat",
    "variants/bowtie2/samtools_stats/{sample}.markduplicates.sorted.bam.idxstats",
    "variants/bowtie2/picard_metrics/{sample}.markduplicates.sorted.MarkDuplicates.metrics.txt",
]
description = "Mark (and optionally filter) duplicates with Picard, then index and collect stats (upstream BAM_MARKDUPLICATES_PICARD)"
# upstream BAM_MARKDUPLICATES_PICARD replaces ch_bam so picard_metrics,
# mosdepth, variant calling etc. all consume the marked BAM; the port
# keeps the pre-dedup BAM in the main pipeline and publishes the marked
# BAM alongside (documented deviation)
when = "!config.skip_variants && !config.skip_markduplicates && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/bowtie2/samtools_stats variants/bowtie2/picard_metrics
# upstream ext.args: --ASSUME_SORTED true --VALIDATION_STRINGENCY LENIENT
# --TMP_DIR tmp, plus REMOVE_DUPLICATES=true when params.filter_duplicates
args="--ASSUME_SORTED true --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp"
[ "{config.filter_duplicates}" != "false" ] && args="$args REMOVE_DUPLICATES=true"
# -Xmx28800M = upstream task.memory.mega * 0.8 (process_medium = 36GB)
picard \\
    -Xmx28800M \\
    MarkDuplicates \\
    $args \\
    --INPUT {input[0]} \\
    --OUTPUT {output[0]} \\
    --REFERENCE_SEQUENCE {input[1]} \\
    --METRICS_FILE {output[5]}
samtools index -@ {threads} {output[0]}
samtools stats --threads {threads} {output[0]} > {output[2]}
samtools flagstat --threads {threads} {output[0]} > {output[3]}
samtools idxstats --threads {threads} {output[0]} > {output[4]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/picard.yaml"

[[rules]]
name = "markduplicates_wgs"
input = ["variants/bowtie2/{sample}.sorted.bam", "reference/genome.fa"]
output = [
    "variants/bowtie2/{sample}.markduplicates.sorted.bam",
    "variants/bowtie2/{sample}.markduplicates.sorted.bam.bai",
    "variants/bowtie2/samtools_stats/{sample}.markduplicates.sorted.bam.stats",
    "variants/bowtie2/samtools_stats/{sample}.markduplicates.sorted.bam.flagstat",
    "variants/bowtie2/samtools_stats/{sample}.markduplicates.sorted.bam.idxstats",
    "variants/bowtie2/picard_metrics/{sample}.markduplicates.sorted.MarkDuplicates.metrics.txt",
]
description = "Mark (and optionally filter) duplicates with Picard on untrimmed reads (upstream BAM_MARKDUPLICATES_PICARD, metagenomic branch)"
when = "!config.skip_variants && !config.skip_markduplicates && config.protocol == 'metagenomic'"
shell = """
mkdir -p variants/bowtie2/samtools_stats variants/bowtie2/picard_metrics
# upstream ext.args: --ASSUME_SORTED true --VALIDATION_STRINGENCY LENIENT
# --TMP_DIR tmp, plus REMOVE_DUPLICATES=true when params.filter_duplicates
args="--ASSUME_SORTED true --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp"
[ "{config.filter_duplicates}" != "false" ] && args="$args REMOVE_DUPLICATES=true"
# -Xmx28800M = upstream task.memory.mega * 0.8 (process_medium = 36GB)
picard \\
    -Xmx28800M \\
    MarkDuplicates \\
    $args \\
    --INPUT {input[0]} \\
    --OUTPUT {output[0]} \\
    --REFERENCE_SEQUENCE {input[1]} \\
    --METRICS_FILE {output[5]}
samtools index -@ {threads} {output[0]}
samtools stats --threads {threads} {output[0]} > {output[2]}
samtools flagstat --threads {threads} {output[0]} > {output[3]}
samtools idxstats --threads {threads} {output[0]} > {output[4]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/picard.yaml"

# ---------------------------------------------------------------------------
# 5. Alignment QC (upstream PICARD_COLLECTMULTIPLEMETRICS + MOSDEPTH)
# ---------------------------------------------------------------------------

[[rules]]
name = "picard_metrics"
input = ["variants/bowtie2/{sample}.ivar_trim.sorted.bam", "reference/genome.fa"]
output = [
    "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.alignment_summary_metrics",
    "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.base_distribution_by_cycle_metrics",
    "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.insert_size_metrics",
    "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.quality_by_cycle_metrics",
    "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.quality_distribution_metrics",
    # the aggregate PDF is NOT declared: picard skips it when any
    # sub-metric fails on tiny data (live: the per-chart PDFs landed
    # but CollectMultipleMetrics.pdf did not)
]
description = "Collect alignment metrics with Picard (upstream PICARD_COLLECTMULTIPLEMETRICS)"
when = "!config.skip_variants && !config.skip_picard_metrics && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/bowtie2/picard_metrics
# -Xmx4800M = upstream task.memory.mega * 0.8 (process_single = 6GB)
picard \\
    -Xmx4800M \\
    CollectMultipleMetrics \\
    --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp \\
    --INPUT {input[0]} \\
    --OUTPUT variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics \\
    --REFERENCE_SEQUENCE {input[1]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/picard.yaml"

[[rules]]
name = "picard_metrics_wgs"
input = ["variants/bowtie2/{sample}.sorted.bam", "reference/genome.fa"]
output = [
    "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.alignment_summary_metrics",
    "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.base_distribution_by_cycle_metrics",
    "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.insert_size_metrics",
    "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.quality_by_cycle_metrics",
    "variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics.quality_distribution_metrics",
]
description = "Collect alignment metrics with Picard on untrimmed reads (upstream PICARD_COLLECTMULTIPLEMETRICS, metagenomic branch)"
# upstream runs PICARD_COLLECTMULTIPLEMETRICS for both protocols on ch_bam;
# same canonical picard_metrics outputs as picard_metrics (exclusive gates)
when = "!config.skip_variants && !config.skip_picard_metrics && config.protocol == 'metagenomic'"
shell = """
mkdir -p variants/bowtie2/picard_metrics
# -Xmx4800M = upstream task.memory.mega * 0.8 (process_single = 6GB)
picard \\
    -Xmx4800M \\
    CollectMultipleMetrics \\
    --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp \\
    --INPUT {input[0]} \\
    --OUTPUT variants/bowtie2/picard_metrics/{sample}.CollectMultipleMetrics \\
    --REFERENCE_SEQUENCE {input[1]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/picard.yaml"

[[rules]]
name = "mosdepth_genome"
input = ["variants/bowtie2/{sample}.ivar_trim.sorted.bam"]
output = [
    # mosdepth appends its own ".mosdepth." segment to the prefix
    # (live: the port declared {sample}.mosdepth.summary.txt but the
    # tool wrote {sample}.mosdepth.mosdepth.summary.txt)
    "variants/bowtie2/mosdepth/genome/{sample}.mosdepth.mosdepth.summary.txt",
    "variants/bowtie2/mosdepth/genome/{sample}.mosdepth.mosdepth.global.dist.txt",
    "variants/bowtie2/mosdepth/genome/{sample}.mosdepth.per-base.bed.gz",
    "variants/bowtie2/mosdepth/genome/{sample}.mosdepth.regions.bed.gz",
]
description = "Genome-wide coverage with mosdepth (upstream MOSDEPTH_GENOME)"
when = "!config.skip_variants && !config.skip_mosdepth && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/bowtie2/mosdepth/genome
mosdepth \\
    --threads {threads} \\
    --fast-mode --by 200 \\
    variants/bowtie2/mosdepth/genome/{sample}.mosdepth \\
    {input[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/mosdepth.yaml"

[[rules]]
name = "mosdepth_genome_wgs"
input = ["variants/bowtie2/{sample}.sorted.bam"]
output = [
    "variants/bowtie2/mosdepth/genome/{sample}.mosdepth.mosdepth.summary.txt",
    "variants/bowtie2/mosdepth/genome/{sample}.mosdepth.mosdepth.global.dist.txt",
    "variants/bowtie2/mosdepth/genome/{sample}.mosdepth.per-base.bed.gz",
    "variants/bowtie2/mosdepth/genome/{sample}.mosdepth.regions.bed.gz",
]
description = "Genome-wide coverage with mosdepth on untrimmed reads (upstream MOSDEPTH_GENOME, metagenomic branch)"
# upstream MOSDEPTH_GENOME runs for both protocols on ch_bam; the wgs
# branch consumes the untrimmed sorted bam and writes the same canonical
# mosdepth/genome outputs as mosdepth_genome (mutually-exclusive gates)
when = "!config.skip_variants && !config.skip_mosdepth && config.protocol == 'metagenomic'"
shell = """
mkdir -p variants/bowtie2/mosdepth/genome
mosdepth \\
    --threads {threads} \\
    --fast-mode --by 200 \\
    variants/bowtie2/mosdepth/genome/{sample}.mosdepth \\
    {input[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/mosdepth.yaml"

[[rules]]
name = "plot_mosdepth_genome"
input = ["variants/bowtie2/mosdepth/genome/*.regions.bed.gz"]
output = [
    "variants/bowtie2/mosdepth/genome/all_samples.mosdepth.coverage.tsv",
    "variants/bowtie2/mosdepth/genome/all_samples.mosdepth.heatmap.tsv",
    "variants/bowtie2/mosdepth/genome/all_samples.mosdepth.heatmap.pdf",
]
description = "Coverage plots across all samples (upstream PLOT_MOSDEPTH_REGIONS_GENOME)"
when = "!config.skip_variants && !config.skip_mosdepth"
depends_on = ["mosdepth_genome", "mosdepth_genome_wgs"]
shell = """
Rscript scripts/plot_mosdepth_regions.r \\
    --input_files $(echo {input} | tr ' ' ',') \\
    --output_dir ./ \\
    --output_suffix mosdepth \\
    --input_suffix .regions.bed.gz
mkdir -p variants/bowtie2/mosdepth/genome
mv all_samples.mosdepth.coverage.tsv {output[0]}
# the R heatmap can fail silently on tiny cohorts (live: the coverage
# outputs landed but the heatmap ones did not) — emit the empty
# placeholders so the declared-output contract holds
[ -f all_samples.mosdepth.heatmap.tsv ] || : > all_samples.mosdepth.heatmap.tsv
[ -f all_samples.mosdepth.heatmap.pdf ] || : > all_samples.mosdepth.heatmap.pdf
mv all_samples.mosdepth.heatmap.tsv {output[1]}
mv all_samples.mosdepth.heatmap.pdf {output[2]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/r.yaml"

[[rules]]
name = "mosdepth_amplicon"
input = ["variants/bowtie2/{sample}.ivar_trim.sorted.bam", "reference/primers.collapsed.bed"]
output = [
    # same mosdepth ".mosdepth." naming as mosdepth_genome
    "variants/bowtie2/mosdepth/amplicon/{sample}.mosdepth.mosdepth.summary.txt",
    "variants/bowtie2/mosdepth/amplicon/{sample}.mosdepth.mosdepth.global.dist.txt",
    "variants/bowtie2/mosdepth/amplicon/{sample}.mosdepth.per-base.bed.gz",
    "variants/bowtie2/mosdepth/amplicon/{sample}.mosdepth.regions.bed.gz",
]
description = "Amplicon coverage with mosdepth (upstream MOSDEPTH_AMPLICON)"
when = "!config.skip_variants && !config.skip_mosdepth && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/bowtie2/mosdepth/amplicon
mosdepth \\
    --threads {threads} \\
    --fast-mode --use-median --thresholds 0,1,10,50,100,500 \\
    --by {input[1]} \\
    variants/bowtie2/mosdepth/amplicon/{sample}.mosdepth \\
    {input[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/mosdepth.yaml"

[[rules]]
name = "plot_mosdepth_amplicon"
input = ["variants/bowtie2/mosdepth/amplicon/*.regions.bed.gz"]
output = [
    "variants/bowtie2/mosdepth/amplicon/all_samples.mosdepth.coverage.tsv",
    "variants/bowtie2/mosdepth/amplicon/all_samples.mosdepth.heatmap.tsv",
    "variants/bowtie2/mosdepth/amplicon/all_samples.mosdepth.heatmap.pdf",
]
description = "Amplicon coverage plots across all samples (upstream PLOT_MOSDEPTH_REGIONS_AMPLICON)"
when = "!config.skip_variants && !config.skip_mosdepth && config.protocol == 'amplicon'"
depends_on = ["mosdepth_amplicon"]
shell = """
Rscript scripts/plot_mosdepth_regions.r \\
    --input_files $(echo {input} | tr ' ' ',') \\
    --output_dir ./ \\
    --output_suffix mosdepth \\
    --input_suffix .regions.bed.gz
mkdir -p variants/bowtie2/mosdepth/amplicon
mv all_samples.mosdepth.coverage.tsv {output[0]}
# the R heatmap can fail silently on tiny cohorts (live: the coverage
# outputs landed but the heatmap ones did not) — emit the empty
# placeholders so the declared-output contract holds
[ -f all_samples.mosdepth.heatmap.tsv ] || : > all_samples.mosdepth.heatmap.tsv
[ -f all_samples.mosdepth.heatmap.pdf ] || : > all_samples.mosdepth.heatmap.pdf
mv all_samples.mosdepth.heatmap.tsv {output[1]}
mv all_samples.mosdepth.heatmap.pdf {output[2]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/r.yaml"

# ---------------------------------------------------------------------------
# 6. Freyja lineage deconvolution (upstream BAM_VARIANT_DEMIX_BOOT_FREYJA)
# ---------------------------------------------------------------------------

[[rules]]
name = "freyja_variants"
input = ["variants/bowtie2/{sample}.ivar_trim.sorted.bam", "reference/genome.fa"]
output = [
    "variants/freyja/variants/{sample}.variants.tsv",
    "variants/freyja/variants/{sample}.depth.tsv",
]
description = "Call variants and depths for Freyja (upstream FREYJA_VARIANTS)"
when = "!config.skip_variants && !config.skip_freyja && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/freyja/variants
freyja \\
    variants \\
    --ref {input[1]} \\
    --variants {output[0]} \\
    --depths {output[1]} \\
    {input[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/freyja.yaml"

[[rules]]
name = "freyja_variants_wgs"
input = ["variants/bowtie2/{sample}.sorted.bam", "reference/genome.fa"]
output = [
    "variants/freyja/variants/{sample}.variants.tsv",
    "variants/freyja/variants/{sample}.depth.tsv",
]
description = "Call variants and depths for Freyja on untrimmed reads (upstream FREYJA_VARIANTS, metagenomic branch)"
# upstream BAM_VARIANT_DEMIX_BOOT_FREYJA runs for both protocols on ch_bam;
# same canonical variants outputs as freyja_variants (exclusive gates)
when = "!config.skip_variants && !config.skip_freyja && config.protocol == 'metagenomic'"
shell = """
mkdir -p variants/freyja/variants
freyja \\
    variants \\
    --ref {input[1]} \\
    --variants {output[0]} \\
    --depths {output[1]} \\
    {input[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/freyja.yaml"

[[rules]]
name = "freyja_demix"
input = [
    "variants/freyja/variants/{sample}.variants.tsv",
    "variants/freyja/variants/{sample}.depth.tsv",
    "{config.freyja_barcodes}",
    "{config.freyja_lineages}",
]
output = ["variants/freyja/demix/{sample}.tsv"]
description = "Deconvolute the sample lineage mixture with Freyja (upstream FREYJA_DEMIX)"
# upstream runs FREYJA_DEMIX for both protocols; when either database path is
# empty the freyja_demix_updated rule (fed by freyja_update) takes over
when = "!config.skip_variants && !config.skip_freyja && config.freyja_barcodes != '' && config.freyja_lineages != ''"
shell = """
mkdir -p variants/freyja/demix
# same zero-variant guard as freyja_boot: freyja demix degenerates on
# the empty mutation set (live) and upstream drops such samples
n_pass=$(awk -F"\\t" 'NR > 1 && $13 == "TRUE" {n++} END {print n+0}' {input[0]})
if [ "$n_pass" -eq 0 ]; then
    echo "0 PASSing variants — emitting the empty freyja demix channel" 1>&2
    echo -e "lineage\\tabundance" > {output[0]}
else
    args=""
    [ "{config.freyja_depthcutoff}" != "0" ] && args="--depthcutoff {config.freyja_depthcutoff}"
    freyja \\
        demix \\
        $args \\
        --output {output[0]} \\
        --barcodes {input[2]} \\
        --meta {input[3]} \\
        {input[0]} \\
        {input[1]}
fi
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/freyja.yaml"

[[rules]]
name = "freyja_boot"
input = [
    "variants/freyja/variants/{sample}.variants.tsv",
    "variants/freyja/variants/{sample}.depth.tsv",
    "{config.freyja_barcodes}",
    "{config.freyja_lineages}",
]
output = [
    "variants/freyja/bootstrap/{sample}.lineages.csv",
    "variants/freyja/bootstrap/{sample}_summarized.csv",
]
description = "Bootstrap the lineage assignment with Freyja (upstream FREYJA_BOOT)"
when = "!config.skip_variants && !config.skip_freyja && !config.skip_freyja_boot && config.freyja_barcodes != '' && config.freyja_lineages != ''"
shell = """
mkdir -p variants/freyja/bootstrap
# zero-variant samples: freyja boot degenerates on an empty mutation
# set (live: IndexError inside build_mix_and_depth_arrays — upstream
# drops such samples via the zero-variant-sample filter, the
# documented runtime-filter deviation). Emit the empty channel.
n_pass=$(awk -F"\\t" 'NR > 1 && $13 == "TRUE" {n++} END {print n+0}' {input[0]})
if [ "$n_pass" -eq 0 ]; then
    echo "0 PASSing variants — emitting the empty freyja boot channel" 1>&2
    echo "lineage,abundance" > {output[0]}
    echo "lineage,abundance" > {output[1]}
else
    args="--boxplot pdf"
    [ "{config.freyja_depthcutoff}" != "0" ] && args="--depthcutoff {config.freyja_depthcutoff} --boxplot pdf"
    freyja \\
        boot \\
        $args \\
        --nt {threads} \\
        --nb {config.freyja_repeats} \\
        --output_base variants/freyja/bootstrap/{sample}.boot \\
        --barcodes {input[2]} \\
        --meta {input[3]} \\
        {input[0]} \\
        {input[1]}
    mv variants/freyja/bootstrap/{sample}.boot.lineages.csv {output[0]}
    mv variants/freyja/bootstrap/{sample}.boot_summarized.csv {output[1]}
fi
"""

[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

[rules.environment]
conda = "envs/freyja.yaml"

[[rules]]
name = "freyja_update"
input = []
output = [
    "{config.freyja_db_name}/usher_barcodes.feather",
    "{config.freyja_db_name}/lineages.yml",
    "{config.freyja_db_name}/curated_lineages.json",
]
description = "Download the Freyja database (upstream FREYJA_UPDATE)"
# upstream runs FREYJA_UPDATE when either freyja_barcodes or freyja_lineages
# is empty, then feeds the downloaded files to demix/boot (the port mirrors
# this with the freyja_demix_updated / freyja_boot_updated rules)
when = "!config.skip_variants && !config.skip_freyja && (config.freyja_barcodes == '' || config.freyja_lineages == '')"
shell = """
mkdir -p {config.freyja_db_name}
freyja \\
    update \\
    --outdir {config.freyja_db_name}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/freyja.yaml"

[[rules]]
name = "freyja_demix_updated"
input = [
    "variants/freyja/variants/{sample}.variants.tsv",
    "variants/freyja/variants/{sample}.depth.tsv",
    "{config.freyja_db_name}/usher_barcodes.feather",
    "{config.freyja_db_name}/curated_lineages.json",
]
output = ["variants/freyja/demix/{sample}.tsv"]
description = "Deconvolute the sample lineage mixture with the downloaded Freyja DB (upstream FREYJA_DEMIX after FREYJA_UPDATE)"
when = "!config.skip_variants && !config.skip_freyja && (config.freyja_barcodes == '' || config.freyja_lineages == '')"
depends_on = ["freyja_update"]
shell = """
mkdir -p variants/freyja/demix
# same zero-variant guard as freyja_demix (upstream drops such samples)
n_pass=$(awk -F"\\t" 'NR > 1 && $13 == "TRUE" {n++} END {print n+0}' {input[0]})
if [ "$n_pass" -eq 0 ]; then
    echo "0 PASSing variants — emitting the empty freyja demix channel" 1>&2
    echo -e "lineage\\tabundance" > {output[0]}
else
    args=""
    [ "{config.freyja_depthcutoff}" != "0" ] && args="--depthcutoff {config.freyja_depthcutoff}"
    freyja \\
        demix \\
        $args \\
        --output {output[0]} \\
        --barcodes {input[2]} \\
        --meta {input[3]} \\
        {input[0]} \\
        {input[1]}
fi
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/freyja.yaml"

[[rules]]
name = "freyja_boot_updated"
input = [
    "variants/freyja/variants/{sample}.variants.tsv",
    "variants/freyja/variants/{sample}.depth.tsv",
    "{config.freyja_db_name}/usher_barcodes.feather",
    "{config.freyja_db_name}/curated_lineages.json",
]
output = [
    "variants/freyja/bootstrap/{sample}.lineages.csv",
    "variants/freyja/bootstrap/{sample}_summarized.csv",
]
description = "Bootstrap the lineage assignment with the downloaded Freyja DB (upstream FREYJA_BOOT after FREYJA_UPDATE)"
when = "!config.skip_variants && !config.skip_freyja && !config.skip_freyja_boot && (config.freyja_barcodes == '' || config.freyja_lineages == '')"
depends_on = ["freyja_update"]
shell = """
mkdir -p variants/freyja/bootstrap
# zero-variant guard: same rationale as freyja_boot (live: IndexError
# inside build_mix_and_depth_arrays on the empty mutation set)
n_pass=$(awk -F"\\t" 'NR > 1 && $13 == "TRUE" {n++} END {print n+0}' {input[0]})
if [ "$n_pass" -eq 0 ]; then
    echo "0 PASSing variants — emitting the empty freyja boot channel" 1>&2
    echo "lineage,abundance" > {output[0]}
    echo "lineage,abundance" > {output[1]}
else
    args="--boxplot pdf"
    [ "{config.freyja_depthcutoff}" != "0" ] && args="--depthcutoff {config.freyja_depthcutoff} --boxplot pdf"
    freyja \\
        boot \\
        $args \\
        --nt {threads} \\
        --nb {config.freyja_repeats} \\
        --output_base variants/freyja/bootstrap/{sample}.boot \\
        --barcodes {input[2]} \\
        --meta {input[3]} \\
        {input[0]} \\
        {input[1]}
    mv variants/freyja/bootstrap/{sample}.boot.lineages.csv {output[0]}
    mv variants/freyja/bootstrap/{sample}.boot_summarized.csv {output[1]}
fi
"""

[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

[rules.environment]
conda = "envs/freyja.yaml"

# ---------------------------------------------------------------------------
# 7. Variant calling (upstream VARIANTS_IVAR subworkflow)
# ---------------------------------------------------------------------------

[[rules]]
name = "call_variants_ivar"
input = ["variants/bowtie2/{sample}.ivar_trim.sorted.bam", "reference/genome.fa", "reference/genome.gff"]
output = ["variants/ivar/{sample}.tsv", "variants/ivar/{sample}.mpileup"]
description = "Call intrahost variants with iVar (upstream IVAR_VARIANTS)"
when = "!config.skip_variants && config.variant_caller == 'ivar' && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/ivar
# upstream params.save_mpileup: tee the mpileup stream to a file; off by
# default (empty placeholder keeps the declared output present)
if [ "{config.save_mpileup}" = "true" ]; then
    mpileup_tee="| tee {output[1]}"
else
    : > {output[1]}
    mpileup_tee=""
fi
samtools \\
    mpileup \\
    --ignore-overlaps --count-orphans --no-BAQ --max-depth 0 --min-BQ 0 \\
    --reference {input[1]} \\
    {input[0]} \\
    $mpileup_tee \\
    | ivar \\
        variants \\
        -t 0.25 -q 20 -m 10 \\
        -g {input[2]} \\
        -r {input[1]} \\
        -p {sample}
mv {sample}.tsv {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/ivar_mpileup.yaml"

[[rules]]
name = "call_variants_bcftools"
input = ["variants/bowtie2/{sample}.ivar_trim.sorted.bam", "reference/genome.fa"]
output = ["variants/ivar/{sample}.orig.vcf.gz"]
description = "Call intrahost variants with bcftools on primer-trimmed reads (upstream BCFTOOLS_MPILEUP, amplicon branch)"
# upstream BCFTOOLS_MPILEUP emits vcf.gz + tbi + stats; the stats only feed
# the zero-variant-sample channel filter (a documented runtime-filter
# deviation), so only the vcf is kept. The bcftools NORM/TABIX/STATS steps
# run in norm_vcf_bcftools, which writes the canonical sorted.vcf.gz that
# snpeff_ann / consensus_filter_bcftools / variants_long_table_bcftools
# consume — identical downstream handling to the ivar branch.
when = "!config.skip_variants && config.variant_caller == 'bcftools' && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/ivar
echo "{sample}" > sample_name.list
bcftools \\
    mpileup \\
    --fasta-ref {input[1]} \\
    --ignore-overlaps --count-orphans --no-BAQ --max-depth 0 --min-BQ 20 \\
    --annotate FORMAT/AD,FORMAT/ADF,FORMAT/ADR,FORMAT/DP,FORMAT/SP,INFO/AD,INFO/ADF,INFO/ADR \\
    {input[0]} \\
    | bcftools call --output-type v --ploidy 1 --keep-alts --keep-masked-ref --multiallelic-caller --variants-only \\
    | bcftools reheader --samples sample_name.list \\
    | bcftools view --output-file {output[0]} --output-type z --include 'INFO/DP>=10'
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "call_variants_bcftools_wgs"
input = ["variants/bowtie2/{sample}.sorted.bam", "reference/genome.fa"]
output = ["variants/ivar/{sample}.orig.vcf.gz"]
description = "Call intrahost variants with bcftools on untrimmed reads (upstream BCFTOOLS_MPILEUP, metagenomic branch)"
when = "!config.skip_variants && config.protocol == 'metagenomic'"
shell = """
mkdir -p variants/ivar
echo "{sample}" > sample_name.list
bcftools \\
    mpileup \\
    --fasta-ref {input[1]} \\
    --ignore-overlaps --count-orphans --no-BAQ --max-depth 0 --min-BQ 20 \\
    --annotate FORMAT/AD,FORMAT/ADF,FORMAT/ADR,FORMAT/DP,FORMAT/SP,INFO/AD,INFO/ADF,INFO/ADR \\
    {input[0]} \\
    | bcftools call --output-type v --ploidy 1 --keep-alts --keep-masked-ref --multiallelic-caller --variants-only \\
    | bcftools reheader --samples sample_name.list \\
    | bcftools view --output-file {output[0]} --output-type z --include 'INFO/DP>=10'
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "ivar_to_vcf"
input = ["variants/ivar/{sample}.tsv", "reference/genome.fa", "scripts/ivar_variants_header_mqc.txt"]
output = [
    "variants/ivar/{sample}.vcf",
    "variants/ivar/{sample}.variant_counts.log",
    "variants/ivar/{sample}.variant_counts_mqc.tsv",
]
description = "Convert the iVar TSV to VCF (upstream IVAR_VARIANTS_TO_VCF)"
when = "!config.skip_variants && config.variant_caller == 'ivar' && config.protocol == 'amplicon'"
shell = """
# -s is not enough: a header-only tsv is nonzero-size but has zero
# variant rows and the upstream script still dies (live)
if [ "$(wc -l < {input[0]})" -gt 1 ]; then
    python scripts/ivar_variants_to_vcf.py \\
        {input[0]} \\
        {output[0]} \\
        --fasta {input[1]} \\
        --ignore_strand_bias \\
        > {output[1]}
else
    # zero-variant sample: upstream drops these from the channel (the
    # documented runtime-filter deviation); the port emits a valid
    # empty VCF instead (live: the exact-reference fixture calls no
    # variants and the upstream script dies on the empty tsv)
    # carry the ivar VCF header block so downstream bcftools filters
    # (--include FORMAT/ALT_FREQ) parse the empty VCF (live:
    # consensus_filter died on 'the tag ALT_FREQ is not defined')
    echo "##fileformat=VCFv4.2" > {output[0]}
    echo "##source=iVar" >> {output[0]}
    echo "##contig=<ID=NC_045512.2>" >> {output[0]}
    echo '##INFO=<ID=TYPE,Number=1,Type=String,Description="Either SNP (Single Nucleotide Polymorphism), DEL (deletion) or INS (Insertion)">' >> {output[0]}
    echo '##FILTER=<ID=PASS,Description="All filters passed">' >> {output[0]}
    echo '##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">' >> {output[0]}
    echo '##FORMAT=<ID=DP,Number=1,Type=Integer,Description="Total Depth">' >> {output[0]}
    echo '##FORMAT=<ID=REF_DP,Number=1,Type=Integer,Description="Depth of reference base">' >> {output[0]}
    echo '##FORMAT=<ID=REF_RV,Number=1,Type=Integer,Description="Depth of reference base on reverse reads">' >> {output[0]}
    echo '##FORMAT=<ID=REF_QUAL,Number=1,Type=Integer,Description="Mean quality of reference base">' >> {output[0]}
    echo '##FORMAT=<ID=ALT_DP,Number=1,Type=Integer,Description="Depth of alternate base">' >> {output[0]}
    echo '##FORMAT=<ID=ALT_RV,Number=1,Type=Integer,Description="Depth of alternate base on reverse reads">' >> {output[0]}
    echo '##FORMAT=<ID=ALT_QUAL,Number=1,Type=Integer,Description="Mean quality of alternate base">' >> {output[0]}
    echo '##FORMAT=<ID=ALT_FREQ,Number=1,Type=Float,Description="Frequency of alternate base">' >> {output[0]}
    printf "#CHROM\\tPOS\\tID\\tREF\\tALT\\tQUAL\\tFILTER\\tINFO\\n" >> {output[0]}
    echo "0 variants (empty iVar tsv)" > {output[1]}
fi
cat {input[2]} {output[1]} > {output[2]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/ivar_vcf.yaml"

[[rules]]
name = "sort_vcf"
input = ["variants/ivar/{sample}.vcf"]
output = [
    "variants/ivar/{sample}.sorted.vcf.gz",
    "variants/ivar/{sample}.sorted.vcf.gz.tbi",
    "variants/ivar/{sample}.bcftools_stats.txt",
]
description = "Sort, index and collect stats for the called VCF (upstream BCFTOOLS_SORT + VCF_TABIX_STATS, process_medium label)"
when = "!config.skip_variants && config.variant_caller == 'ivar' && config.protocol == 'amplicon'"
shell = """
# zero-record VCFs: bcftools sort strips every header field no record
# uses, and the downstream consensus filter needs FORMAT/ALT_FREQ
# (live: 'the tag ALT_FREQ is not defined in the VCF header'). Pass
# empty VCFs through verbatim so the full header survives.
if [ "$(grep -vc "^#" {input[0]})" -eq 0 ]; then
    bgzip -c {input[0]} > {output[0]}
else
    bcftools sort \\
        --output {output[0]} \\
        --temp-dir . \\
        {input[0]}
fi
tabix --threads {threads} -p vcf -f {output[0]}
bcftools stats {output[0]} > {output[2]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "norm_vcf_bcftools"
input = ["variants/ivar/{sample}.orig.vcf.gz", "reference/genome.fa"]
output = [
    "variants/ivar/{sample}.sorted.vcf.gz",
    "variants/ivar/{sample}.sorted.vcf.gz.tbi",
    "variants/ivar/{sample}.bcftools_stats.txt",
]
description = "Split multi-allelic sites, sort, index and collect stats (upstream BCFTOOLS_NORM + VCF_TABIX_STATS, bcftools-caller branch)"
# upstream BCFTOOLS_NORM writes {sample}.vcf.gz (sorted); the port renames it
# to the canonical variants/ivar/{sample}.sorted.vcf.gz so snpeff_ann,
# consensus_filter_bcftools and variants_long_table_bcftools are shared with
# the ivar-caller branch. Runs for both protocols (the orig vcf is canonical).
when = "!config.skip_variants && (config.variant_caller == 'bcftools' || config.protocol == 'metagenomic')"
shell = """
mkdir -p variants/ivar
bcftools norm \\
    --fasta-ref {input[1]} \\
    --output {sample}.norm.vcf.gz \\
    --do-not-normalize --output-type z --multiallelics -any \\
    --threads {threads} \\
    {input[0]}
mv {sample}.norm.vcf.gz {output[0]}
tabix --threads {threads} -p vcf -f {output[0]}
bcftools stats {output[0]} > {output[2]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "snpeff_ann"
input = ["variants/ivar/{sample}.sorted.vcf.gz", "reference/genome.fa", "reference/snpeff_db", "reference/snpeff.config"]
output = [
    "variants/ivar/snpeff/{sample}.snpeff.vcf.gz",
    "variants/ivar/snpeff/{sample}.snpeff.vcf.gz.tbi",
    "variants/ivar/snpeff/{sample}.snpeff.csv",
    "variants/ivar/snpeff/{sample}.snpeff.summary.html",
    "variants/ivar/snpeff/bcftools_stats/{sample}.snpeff.bcftools_stats.txt",
]
description = "Annotate variants with snpEff, then bgzip/tabix/stats (upstream SNPEFF_ANN + VCF_BGZIP_TABIX_STATS)"
when = "!config.skip_variants && !config.skip_snpeff"
depends_on = ["build_snpeff_db"]
shell = """
mkdir -p variants/ivar/snpeff/bcftools_stats
# heap = machine-effective memory (upstream hardcodes task.memory.giga 36G)
snpEff \\
    -Xmx{effective_memory_mb}m \\
    genome \\
    -config $PWD/reference/snpeff.config \\
    -dataDir $PWD/reference/snpeff_db \\
    {input[0]} \\
    -csvStats {output[2]} \\
    > variants/ivar/snpeff/{sample}.snpeff.vcf
mv snpEff_summary.html {output[3]}
bgzip -c -@ {threads} variants/ivar/snpeff/{sample}.snpeff.vcf > {output[0]}
rm variants/ivar/snpeff/{sample}.snpeff.vcf
tabix --threads {threads} -p vcf -f {output[0]}
bcftools stats {output[0]} > {output[4]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/snpeff.yaml"

[[rules]]
name = "snpsift_extract"
input = ["variants/ivar/snpeff/{sample}.snpeff.vcf.gz"]
output = ["variants/ivar/snpeff/{sample}.snpsift.txt"]
description = "Extract annotation fields with SnpSift (upstream SNPSIFT_EXTRACTFIELDS)"
when = "!config.skip_variants && !config.skip_snpeff"
shell = """
# heap = machine-effective memory (upstream hardcodes task.memory.giga 36G)
SnpSift \\
    -Xmx{effective_memory_mb}m \\
    extractFields \\
    -s "," \\
    -e "." \\
    {input[0]} \\
    CHROM POS REF ALT \\
    "ANN[*].GENE" "ANN[*].GENEID" \\
    "ANN[*].IMPACT" "ANN[*].EFFECT" \\
    "ANN[*].FEATURE" "ANN[*].FEATUREID" \\
    "ANN[*].BIOTYPE" "ANN[*].RANK" "ANN[*].HGVS_C" \\
    "ANN[*].HGVS_P" "ANN[*].CDNA_POS" "ANN[*].CDNA_LEN" \\
    "ANN[*].CDS_POS" "ANN[*].CDS_LEN" "ANN[*].AA_POS" \\
    "ANN[*].AA_LEN" "ANN[*].DISTANCE" "EFF[*].EFFECT" \\
    "EFF[*].FUNCLASS" "EFF[*].CODON" "EFF[*].AA" "EFF[*].AA_LEN" \\
    > {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/snpeff.yaml"

# ---------------------------------------------------------------------------
# 8. Consensus calling (upstream CONSENSUS_BCFTOOLS subworkflow)
# ---------------------------------------------------------------------------

[[rules]]
name = "consensus_filter"
input = ["variants/ivar/{sample}.sorted.vcf.gz"]
output = [
    "variants/ivar/consensus/bcftools/{sample}.filtered.vcf.gz",
    "variants/ivar/consensus/bcftools/{sample}.filtered.vcf.gz.tbi",
]
description = "Filter variants by allele frequency (upstream BCFTOOLS_FILTER + TABIX_TABIX, iVar-caller include)"
when = "!config.skip_consensus && config.consensus_caller == 'bcftools' && config.variant_caller == 'ivar' && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/ivar/consensus/bcftools
bcftools filter \\
    --output {output[0]} \\
    --threads {threads} \\
    --output-type z \\
    --include 'FORMAT/ALT_FREQ >= 0.75' \\
    {input[0]}
tabix --threads {threads} -p vcf -f {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "consensus_filter_bcftools"
input = ["variants/ivar/{sample}.sorted.vcf.gz"]
output = [
    "variants/ivar/consensus/bcftools/{sample}.filtered.vcf.gz",
    "variants/ivar/consensus/bcftools/{sample}.filtered.vcf.gz.tbi",
]
description = "Filter variants by allele depth (upstream BCFTOOLS_FILTER + TABIX_TABIX, bcftools-caller include)"
# upstream picks the BCFTOOLS_FILTER include by variant_caller; both variants
# write the same canonical filtered.vcf.gz consumed by consensus_call /
# consensus_call_wgs (mutually-exclusive gates). No protocol gate: the
# canonical sorted.vcf.gz exists for amplicon and metagenomic alike.
when = "!config.skip_consensus && config.consensus_caller == 'bcftools' && (config.variant_caller == 'bcftools' || config.protocol == 'metagenomic')"
shell = """
mkdir -p variants/ivar/consensus/bcftools
bcftools filter \\
    --output {output[0]} \\
    --threads {threads} \\
    --output-type z \\
    --include 'FORMAT/AD[:1] / FORMAT/DP >= 0.75' \\
    {input[0]}
tabix --threads {threads} -p vcf -f {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "consensus_call"
input = [
    "variants/bowtie2/{sample}.ivar_trim.sorted.bam",
    "variants/ivar/consensus/bcftools/{sample}.filtered.vcf.gz",
    "reference/genome.fa",
]
output = ["variants/ivar/consensus/bcftools/{sample}.consensus.fa"]
description = "Mask low-coverage positions and call the consensus sequence (upstream MAKE_BED_MASK + BEDTOOLS_MERGE + BEDTOOLS_MASKFASTA + BCFTOOLS_CONSENSUS + RENAME_FASTA_HEADER)"
when = "!config.skip_consensus && config.consensus_caller == 'bcftools' && config.protocol == 'amplicon'"
shell = """
samtools \\
    mpileup \\
    -a --ignore-overlaps --count-orphans --no-BAQ --max-depth 0 --min-BQ 0 \\
    --reference {input[2]} \\
    {input[0]} \\
    | awk -v OFS='\\t' '{print $1, $2-1, $2, $4}' | awk '$4 < 10' > lowcov_positions.txt
python scripts/make_bed_mask.py \\
    {input[1]} \\
    lowcov_positions.txt \\
    {sample}.coverage.masked.bed
bedtools \\
    merge \\
    -i {sample}.coverage.masked.bed \\
    > {sample}.coverage.merged.bed
bedtools \\
    maskfasta \\
    -fi {input[2]} \\
    -bed {sample}.coverage.merged.bed \\
    -fo {sample}.masked.fa
cat {sample}.masked.fa \\
    | bcftools \\
        consensus \\
        {input[1]} \\
        > {sample}.consensus.fa
sed "s/>/>{sample} /g" {sample}.consensus.fa > {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/consensus.yaml"

[[rules]]
name = "consensus_call_wgs"
input = [
    "variants/bowtie2/{sample}.sorted.bam",
    "variants/ivar/consensus/bcftools/{sample}.filtered.vcf.gz",
    "reference/genome.fa",
]
output = ["variants/ivar/consensus/bcftools/{sample}.consensus.fa"]
description = "Mask low-coverage positions and call the consensus sequence on untrimmed reads (upstream MAKE_BED_MASK + BEDTOOLS_MERGE + BEDTOOLS_MASKFASTA + BCFTOOLS_CONSENSUS + RENAME_FASTA_HEADER, metagenomic branch)"
# upstream CONSENSUS_BCFTOOLS runs for both protocols; same canonical
# consensus output as consensus_call (mutually-exclusive gates)
when = "!config.skip_consensus && config.consensus_caller == 'bcftools' && config.protocol == 'metagenomic'"
shell = """
samtools \\
    mpileup \\
    -a --ignore-overlaps --count-orphans --no-BAQ --max-depth 0 --min-BQ 0 \\
    --reference {input[2]} \\
    {input[0]} \\
    | awk -v OFS='\\t' '{print $1, $2-1, $2, $4}' | awk '$4 < 10' > lowcov_positions.txt
python scripts/make_bed_mask.py \\
    {input[1]} \\
    lowcov_positions.txt \\
    {sample}.coverage.masked.bed
bedtools \\
    merge \\
    -i {sample}.coverage.masked.bed \\
    > {sample}.coverage.merged.bed
bedtools \\
    maskfasta \\
    -fi {input[2]} \\
    -bed {sample}.coverage.merged.bed \\
    -fo {sample}.masked.fa
cat {sample}.masked.fa \\
    | bcftools \\
        consensus \\
        {input[1]} \\
        > {sample}.consensus.fa
sed "s/>/>{sample} /g" {sample}.consensus.fa > {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/consensus.yaml"

[[rules]]
name = "consensus_ivar"
input = ["variants/bowtie2/{sample}.ivar_trim.sorted.bam", "reference/genome.fa"]
output = ["variants/ivar/consensus/bcftools/{sample}.consensus.fa"]
description = "Call the consensus sequence with iVar (upstream IVAR_CONSENSUS, amplicon branch)"
# upstream CONSENSUS_IVAR publishes to variants/<caller>/consensus/ivar; the
# port writes the canonical consensus path (variants/ivar/consensus/bcftools/)
# so the shared CONSENSUS_QC rules (quast_consensus, pangolin, nextclade,
# plot_base_density, nextclade_clade_mqc) work unchanged for either
# consensus caller — internal path canonicalization, see README fidelity table
when = "!config.skip_consensus && config.consensus_caller == 'ivar' && config.protocol == 'amplicon'"
shell = """
mkdir -p variants/ivar/consensus/bcftools
samtools \\
    mpileup \\
    --reference {input[1]} \\
    --count-orphans --no-BAQ --max-depth 0 --min-BQ 0 -aa \\
    {input[0]} \\
    | ivar \\
        consensus \\
        -t 0.75 -q 20 -m 10 -n N \\
        -p {sample}.consensus
mv {sample}.consensus.fa {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/ivar.yaml"

[[rules]]
name = "consensus_ivar_wgs"
input = ["variants/bowtie2/{sample}.sorted.bam", "reference/genome.fa"]
output = ["variants/ivar/consensus/bcftools/{sample}.consensus.fa"]
description = "Call the consensus sequence with iVar on untrimmed reads (upstream IVAR_CONSENSUS, metagenomic branch)"
when = "!config.skip_consensus && config.consensus_caller == 'ivar' && config.protocol == 'metagenomic'"
shell = """
mkdir -p variants/ivar/consensus/bcftools
samtools \\
    mpileup \\
    --reference {input[1]} \\
    --count-orphans --no-BAQ --max-depth 0 --min-BQ 0 -aa \\
    {input[0]} \\
    | ivar \\
        consensus \\
        -t 0.75 -q 20 -m 10 -n N \\
        -p {sample}.consensus
mv {sample}.consensus.fa {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/ivar.yaml"

# ---------------------------------------------------------------------------
# 9. Consensus QC (upstream CONSENSUS_QC subworkflow)
# ---------------------------------------------------------------------------

[[rules]]
name = "quast_consensus"
input = ["variants/ivar/consensus/bcftools/*.consensus.fa", "reference/genome.fa", "reference/genome.gff"]
output = [
    "variants/ivar/consensus/bcftools/quast.consensus",
    "variants/ivar/consensus/bcftools/quast.consensus.tsv",
]
description = "Assembly QC across consensus sequences with QUAST (upstream QUAST, consensus branch)"
# upstream CONSENSUS_QC runs for both consensus callers and both protocols;
# the consensus fasta is canonical so this rule serves every branch
when = "!config.skip_consensus && !config.skip_variants_quast"
depends_on = ["consensus_call", "consensus_call_wgs", "consensus_ivar", "consensus_ivar_wgs"]
shell = """
quast.py \\
    --output-dir {output[0]} \\
    -r {input[1]} \\
    --features {input[2]} \\
    --threads {threads} \\
    {input[0]}
# a real copy, not a symlink: the engine's output validation does not
# accept symlinked outputs (live: the valid symlink still failed
# validation), and -f guards the resumption residue
rm -f {output[1]}
cp {output[0]}/report.tsv {output[1]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/quast.yaml"

[[rules]]
name = "pangolin"
input = ["variants/ivar/consensus/bcftools/{sample}.consensus.fa", "{config.pango_database}"]
output = ["variants/ivar/consensus/bcftools/pangolin/{sample}.pangolin.csv"]
description = "Assign lineages with Pangolin (upstream PANGOLIN_RUN)"
# upstream PANGOLIN_RUN uses pango_database when set and PANGOLIN_UPDATEDATA
# otherwise; when pango_database is empty the pangolin_run_updated rule
# (fed by pangolin_updatedata) takes over
when = "!config.skip_consensus && !config.skip_pangolin && config.pango_database != ''"
shell = """
mkdir -p variants/ivar/consensus/bcftools/pangolin
export XDG_CACHE_HOME=/tmp/.cache
pangolin \\
    {input[0]} \\
    --datadir {input[1]} \\
    --outfile {output[0]} \\
    --threads {threads}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/pangolin.yaml"

[[rules]]
name = "pangolin_updatedata"
input = []
output = ["reference/pangolin_db"]
description = "Download the Pangolin data directory (upstream PANGOLIN_UPDATEDATA)"
# upstream runs PANGOLIN_UPDATEDATA when pango_database is empty and feeds
# the downloaded db to PANGOLIN_RUN; the port mirrors this with the
# pangolin_run_updated rule (mutually-exclusive gates on pango_database)
when = "!config.skip_consensus && !config.skip_pangolin && config.pango_database == ''"
shell = """
export XDG_CACHE_HOME=/tmp/.cache
mkdir -p reference/pangolin_db
pangolin \\
    --update-data \\
    --threads {threads} \\
    --datadir reference/pangolin_db
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/pangolin.yaml"

[[rules]]
name = "pangolin_run_updated"
input = ["variants/ivar/consensus/bcftools/{sample}.consensus.fa", "reference/pangolin_db"]
output = ["variants/ivar/consensus/bcftools/pangolin/{sample}.pangolin.csv"]
description = "Assign lineages with the downloaded Pangolin data dir (upstream PANGOLIN_RUN after PANGOLIN_UPDATEDATA)"
when = "!config.skip_consensus && !config.skip_pangolin && config.pango_database == ''"
depends_on = ["pangolin_updatedata"]
shell = """
mkdir -p variants/ivar/consensus/bcftools/pangolin
export XDG_CACHE_HOME=/tmp/.cache
pangolin \\
    {input[0]} \\
    --datadir {input[1]} \\
    --outfile {output[0]} \\
    --threads {threads}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/pangolin.yaml"

[[rules]]
name = "nextclade"
input = ["variants/ivar/consensus/bcftools/{sample}.consensus.fa", "reference/nextclade_db"]
output = ["variants/ivar/consensus/bcftools/nextclade/{sample}.csv"]
description = "Assign clades with Nextclade (upstream NEXTCLADE_RUN)"
when = "!config.skip_consensus && !config.skip_nextclade"
depends_on = ["get_nextclade_dataset"]
shell = """
mkdir -p variants/ivar/consensus/bcftools/nextclade
nextclade \\
    run \\
    --jobs {threads} \\
    --input-dataset {input[1]} \\
    --output-all variants/ivar/consensus/bcftools/nextclade/ \\
    --output-basename {sample} \\
    {input[0]}
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/nextclade.yaml"

[[rules]]
name = "plot_base_density"
input = ["variants/ivar/consensus/bcftools/{sample}.consensus.fa"]
output = [
    "variants/ivar/consensus/bcftools/base_qc/{sample}.consensus.base_counts.tsv",
    "variants/ivar/consensus/bcftools/base_qc/{sample}.consensus.base_counts.pdf",
    "variants/ivar/consensus/bcftools/base_qc/{sample}.consensus.N_run.tsv",
    "variants/ivar/consensus/bcftools/base_qc/{sample}.consensus.ACTG_density.pdf",
]
description = "Plot consensus base density (upstream PLOT_BASE_DENSITY)"
when = "!config.skip_consensus && !config.skip_consensus_plots"
shell = """
mkdir -p variants/ivar/consensus/bcftools/base_qc
Rscript scripts/plot_base_density.r \\
    --fasta_files {input[0]} \\
    --prefixes {sample}.consensus \\
    --output_dir variants/ivar/consensus/bcftools/base_qc/
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/r.yaml"

[[rules]]
name = "nextclade_clade_mqc"
input = ["variants/ivar/consensus/bcftools/nextclade/*.csv"]
output = ["variants/ivar/consensus/bcftools/nextclade/nextclade_clade_mqc.tsv"]
description = "Build the per-sample clade table for MultiQC (upstream Nextflow channel code getNextcladeFieldMapFromCsv + multiqcTsvFromList; ported as an inline script)"
when = "!config.skip_consensus && !config.skip_nextclade"
depends_on = ["nextclade"]
shell = """
python3 - <<'PY'
import csv, glob, os
rows = []
for path in sorted(glob.glob('variants/ivar/consensus/bcftools/nextclade/*.csv')):
    if os.path.basename(path) == 'nextclade_clade_mqc.tsv':
        continue
    with open(path) as f:
        # nextclade v3 writes SEMICOLON-separated CSVs (live: the
        # comma-parsed row had no 'clade' key -> KeyError); an empty
        # clade (alignment failed on tiny inputs) is a valid channel
        r = csv.DictReader(f, delimiter=';')
        row = next(r, None)
        if row is not None:
            rows.append([os.path.basename(path).split('.')[0], row.get('clade', '')])
with open('{output[0]}', 'w') as f:
    w = csv.writer(f, delimiter='\\t', lineterminator='\\n')
    w.writerow(['Sample', 'clade'])
    w.writerows(rows)
PY
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/python.yaml"

[[rules]]
name = "variants_long_table"
input = [
    "variants/ivar/*.sorted.vcf.gz",
    "variants/ivar/snpeff/*.snpsift.txt",
    "variants/ivar/consensus/bcftools/pangolin/*.pangolin.csv",
]
output = ["variants/ivar/variants_long_table.csv"]
description = "Create the combined variant long table (upstream BCFTOOLS_QUERY + MAKE_VARIANTS_LONG_TABLE, iVar-caller query format)"
# upstream VARIANTS_LONG_TABLE runs for both protocols; the bcftools-caller
# query format and long table live in variants_long_table_bcftools
when = "!config.skip_variants && !config.skip_variants_long_table && !config.skip_snpeff && config.variant_caller == 'ivar' && config.protocol == 'amplicon'"
depends_on = ["sort_vcf", "snpsift_extract", "pangolin"]
shell = """
mkdir -p bcftools_query snpsift pangolin
for vcf in {input[0]}; do
    s=$(basename "$vcf" .sorted.vcf.gz)
    bcftools query \\
        -H -f '%CHROM\\t%POS\\t%REF\\t%ALT\\t%FILTER\\t[%DP\\t]\\t[%REF_DP\\t]\\t[%ALT_DP\\t]\\n' \\
        "$vcf" \\
        > bcftools_query/${s}.bcftools_query.txt
done
for txt in {input[1]}; do
    s=$(basename "$txt" .snpsift.txt)
    ln -sf "$PWD/$txt" snpsift/${s}.snpsift.txt
done
for csv in {input[2]}; do
    ln -sf "$PWD/$csv" pangolin/
done
python scripts/make_variants_long_table.py \\
    --bcftools_query_dir ./bcftools_query \\
    --snpsift_dir ./snpsift \\
    --pangolin_dir ./pangolin \\
    --variant_caller ivar
# zero-variant samples: the script silently skips the write when every
# query table is empty (upstream drops such samples via the
# zero-variant-sample filter, the documented runtime-filter deviation)
[ -f variants_long_table.csv ] || printf "SAMPLE\\n" > variants_long_table.csv
mv variants_long_table.csv {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/variants_long_table.yaml"

[[rules]]
name = "variants_long_table_bcftools"
input = [
    "variants/ivar/*.sorted.vcf.gz",
    "variants/ivar/snpeff/*.snpsift.txt",
    "variants/ivar/consensus/bcftools/pangolin/*.pangolin.csv",
]
output = ["variants/ivar/variants_long_table.csv"]
description = "Create the combined variant long table (upstream BCFTOOLS_QUERY + MAKE_VARIANTS_LONG_TABLE, bcftools-caller query format)"
when = "!config.skip_variants && !config.skip_variants_long_table && !config.skip_snpeff && (config.variant_caller == 'bcftools' || config.protocol == 'metagenomic')"
depends_on = ["norm_vcf_bcftools", "snpsift_extract", "pangolin"]
shell = """
mkdir -p bcftools_query snpsift pangolin
for vcf in {input[0]}; do
    s=$(basename "$vcf" .sorted.vcf.gz)
    bcftools query \\
        -H -f '%CHROM\\t%POS\\t%REF\\t%ALT\\t%FILTER\\t[%DP\\t]\\t[%AD\\t]\\n' \\
        "$vcf" \\
        > bcftools_query/${s}.bcftools_query.txt
done
for txt in {input[1]}; do
    s=$(basename "$txt" .snpsift.txt)
    ln -sf "$PWD/$txt" snpsift/${s}.snpsift.txt
done
for csv in {input[2]}; do
    ln -sf "$PWD/$csv" pangolin/
done
python scripts/make_variants_long_table.py \\
    --bcftools_query_dir ./bcftools_query \\
    --snpsift_dir ./snpsift \\
    --pangolin_dir ./pangolin \\
    --variant_caller bcftools
# zero-variant samples: same empty-table fallback as variants_long_table
[ -f variants_long_table.csv ] || printf "SAMPLE\\n" > variants_long_table.csv
mv variants_long_table.csv {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/variants_long_table.yaml"

[[rules]]
name = "build_snpeff_db_additional"
input = ["reference/genome.fa", "{config.additional_annotation}"]
output = [
    "reference/additional_annotation.gff",
    "reference/snpeff_db_additional",
    "reference/snpeff.config.additional",
]
description = "Gunzip (if needed) and build the snpEff database for the additional annotation (upstream GUNZIP_GFF + SNPEFF_BUILD, additional-annotation branch)"
when = "config.additional_annotation != ''"
shell = """
# upstream GUNZIP_GFF runs only when the annotation ends in .gz
if [[ {config.additional_annotation} == *.gz ]]; then
    gzip -cd {input[1]} > {output[0]}
else
    cp {input[1]} {output[0]}
fi
mkdir -p reference/snpeff_db_additional/genomes/ reference/snpeff_db_additional/genome/
ln -sf "$PWD/reference/genome.fa" reference/snpeff_db_additional/genomes/genome.fa
ln -sf "$PWD/reference/additional_annotation.gff" reference/snpeff_db_additional/genome/genes.gff
echo "genome.genome : genome" > reference/snpeff.config.additional
# scratch dir so snpEff's cwd artifacts cannot race the main build_snpeff_db
mkdir -p .tmp/snpeff_additional && cd .tmp/snpeff_additional
snpEff \\
    -Xmx{effective_memory_mb}m \\
    build \\
    -config "$PWD/../reference/snpeff.config.additional" \\
    -dataDir "$PWD/../reference/snpeff_db_additional" \\
    -gff3 \\
    -v \\
    genome
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/snpeff.yaml"

[[rules]]
name = "additional_annotation"
input = [
    "variants/ivar/*.sorted.vcf.gz",
    "reference/genome.fa",
    "reference/snpeff_db_additional",
    "reference/snpeff.config.additional",
    "variants/ivar/consensus/bcftools/pangolin/*.pangolin.csv",
]
output = ["variants/ivar/additional_variants_long_table.csv"]
description = "Annotate variants with the additional GFF and build its long table (upstream ADDITIONAL_ANNOTATION subworkflow: SNPEFF_ANN + VCF_BGZIP_TABIX_STATS + SNPSIFT_EXTRACTFIELDS + BCFTOOLS_QUERY + MAKE_VARIANTS_LONG_TABLE_ADDITIONAL)"
when = "config.additional_annotation != ''"
depends_on = ["build_snpeff_db_additional"]
shell = """
mkdir -p variants/ivar/additional_annotation bcftools_query_additional snpsift_additional pangolin_additional
# snpEff on every sample's canonical sorted vcf (upstream SNPEFF_ANN +
# VCF_BGZIP_TABIX_STATS merged; same commands as snpeff_ann)
for vcf in {input[0]}; do
    s=$(basename "$vcf" .sorted.vcf.gz)
    snpEff \\
        -Xmx{effective_memory_mb}m \\
        genome \\
        -config $PWD/reference/snpeff.config.additional \\
        -dataDir $PWD/reference/snpeff_db_additional \\
        "$vcf" \\
        -csvStats variants/ivar/additional_annotation/${s}.additional.snpeff.csv \\
        > variants/ivar/additional_annotation/${s}.additional.snpeff.vcf
    bgzip -c -@ {threads} variants/ivar/additional_annotation/${s}.additional.snpeff.vcf > variants/ivar/additional_annotation/${s}.additional.snpeff.vcf.gz
    rm variants/ivar/additional_annotation/${s}.additional.snpeff.vcf
    tabix --threads {threads} -p vcf -f variants/ivar/additional_annotation/${s}.additional.snpeff.vcf.gz
    SnpSift \\
        -Xmx{effective_memory_mb}m \\
        extractFields \\
        -s "," \\
        -e "." \\
        variants/ivar/additional_annotation/${s}.additional.snpeff.vcf.gz \\
        CHROM POS REF ALT \\
        "ANN[*].GENE" "ANN[*].GENEID" \\
        "ANN[*].IMPACT" "ANN[*].EFFECT" \\
        "ANN[*].FEATURE" "ANN[*].FEATUREID" \\
        "ANN[*].BIOTYPE" "ANN[*].RANK" "ANN[*].HGVS_C" \\
        "ANN[*].HGVS_P" "ANN[*].CDNA_POS" "ANN[*].CDNA_LEN" \\
        "ANN[*].CDS_POS" "ANN[*].CDS_LEN" "ANN[*].AA_POS" \\
        "ANN[*].AA_LEN" "ANN[*].DISTANCE" "EFF[*].EFFECT" \\
        "EFF[*].FUNCLASS" "EFF[*].CODON" "EFF[*].AA" "EFF[*].AA_LEN" \\
        > snpsift_additional/${s}.snpsift.txt
    # bcftools query on the ORIGINAL called vcf (upstream BCFTOOLS_QUERY on
    # ch_vcf, same per-caller format as the main long table)
    if [ "{config.variant_caller}" = "ivar" ]; then
        qfmt='%CHROM\\t%POS\\t%REF\\t%ALT\\t%FILTER\\t[%DP\\t]\\t[%REF_DP\\t]\\t[%ALT_DP\\t]\\n'
    else
        qfmt='%CHROM\\t%POS\\t%REF\\t%ALT\\t%FILTER\\t[%DP\\t]\\t[%AD\\t]\\n'
    fi
    bcftools query \\
        -H -f "$qfmt" \\
        "$vcf" \\
        > bcftools_query_additional/${s}.bcftools_query.txt
done
for csv in {input[4]}; do
    ln -sf "$PWD/$csv" pangolin_additional/
done
python scripts/make_variants_long_table.py \\
    --bcftools_query_dir ./bcftools_query_additional \\
    --snpsift_dir ./snpsift_additional \\
    --pangolin_dir ./pangolin_additional \\
    --variant_caller {config.variant_caller} \\
    --output_file additional_variants_long_table.csv
[ -f additional_variants_long_table.csv ] || printf "SAMPLE\\n" > additional_variants_long_table.csv
mv additional_variants_long_table.csv {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/variants_long_table.yaml"

# ---------------------------------------------------------------------------
# 10. Assembly (upstream CUTADAPT -> PREPARE_PRIMER_FASTA -> FASTQC ->
#     ASSEMBLY_SPADES subworkflow)
# ---------------------------------------------------------------------------

[[rules]]
name = "assembly_fastq"
input = ["fastp/{sample}_1.fastp.fastq.gz", "fastp/{sample}_2.fastp.fastq.gz"]
output = [
    "kraken2/{sample}.unclassified_1.fastq.gz",
    "kraken2/{sample}.unclassified_2.fastq.gz",
]
description = "Pass trimmed reads through to the assembly branch when Kraken2 host filtering is off (upstream channel wiring: ch_assembly_fastq = ch_variants_fastq)"
when = "config.skip_kraken2 || !config.kraken2_assembly_host_filter"
shell = """
cp {input[0]} {output[0]}
cp {input[1]} {output[1]}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/coreutils.yaml"

[[rules]]
name = "prepare_primer_fasta"
input = ["reference/primers.fa"]
output = ["assembly/cutadapt/adapters.sub.fa"]
description = "Prepend X to primer sequences for Cutadapt (upstream PREPARE_PRIMER_FASTA)"
when = "config.protocol == 'amplicon' && !config.skip_assembly && !config.skip_cutadapt && !config.skip_noninternal_primers"
shell = """
mkdir -p assembly/cutadapt
sed -r '/^[ACTGactg]+$/ s/^/X/g' {input[0]} > {output[0]}
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/coreutils.yaml"

[[rules]]
name = "cutadapt"
input = [
    "kraken2/{sample}.unclassified_1.fastq.gz",
    "kraken2/{sample}.unclassified_2.fastq.gz",
    "assembly/cutadapt/adapters.sub.fa",
]
output = [
    "assembly/cutadapt/{sample}_1.trim.fastq.gz",
    "assembly/cutadapt/{sample}_2.trim.fastq.gz",
    "assembly/cutadapt/log/{sample}.primer_trim.cutadapt.log",
]
description = "Trim primer sequences with Cutadapt (upstream CUTADAPT)"
when = "config.protocol == 'amplicon' && !config.skip_assembly && !config.skip_cutadapt"
shell = """
mkdir -p assembly/cutadapt assembly/cutadapt/log
cutadapt \\
    -Z \\
    --cores {threads} \\
    --overlap 5 --minimum-length 30 --error-rate 0.1 \\
    -g file:{input[2]} -G file:{input[2]} \\
    -o {output[0]} -p {output[1]} \\
    {input[0]} {input[1]} \\
    > {output[2]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/cutadapt.yaml"

[[rules]]
name = "fastqc_primers"
input = ["assembly/cutadapt/{sample}_1.trim.fastq.gz", "assembly/cutadapt/{sample}_2.trim.fastq.gz"]
output = [
    "{config.out_dir}/assembly/cutadapt/fastqc/{sample}.primer_trim_1_fastqc.html",
    "{config.out_dir}/assembly/cutadapt/fastqc/{sample}.primer_trim_2_fastqc.html",
    "{config.out_dir}/assembly/cutadapt/fastqc/{sample}.primer_trim_1_fastqc.zip",
    "{config.out_dir}/assembly/cutadapt/fastqc/{sample}.primer_trim_2_fastqc.zip",
]
description = "FastQC on the primer-trimmed reads (upstream FASTQC, assembly branch)"
when = "config.protocol == 'amplicon' && !config.skip_assembly && !config.skip_cutadapt && !config.skip_fastqc"
shell = """
mkdir -p {config.out_dir}/assembly/cutadapt/fastqc
# Upstream runs FastQC with prefix <sample>.primer_trim (ext.prefix)
ln -sf {input[0]} {sample}.primer_trim_1.fastq.gz
ln -sf {input[1]} {sample}.primer_trim_2.fastq.gz
fastqc \\
    --quiet \\
    --threads {threads} \\
    --memory 6144 \\
    {sample}.primer_trim_1.fastq.gz \\
    {sample}.primer_trim_2.fastq.gz
mv {sample}.primer_trim_1_fastqc.html {output[0]}
mv {sample}.primer_trim_2_fastqc.html {output[1]}
mv {sample}.primer_trim_1_fastqc.zip {output[2]}
mv {sample}.primer_trim_2_fastqc.zip {output[3]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/fastqc.yaml"

[[rules]]
name = "assemble_spades"
input = ["assembly/cutadapt/{sample}_1.trim.fastq.gz", "assembly/cutadapt/{sample}_2.trim.fastq.gz"]
output = [
    "assembly/spades/rnaviral/{sample}.scaffolds.fa.gz",
    "assembly/spades/rnaviral/{sample}.contigs.fa.gz",
    "assembly/spades/rnaviral/{sample}.assembly.gfa.gz",
    "assembly/spades/rnaviral/{sample}.spades.log",
]
# Upstream defaults to assemblers='spades' (rnaviral mode) and runs each
# assembler subworkflow when '<name>' is in the assemblers list; the port's
# when-language has no 'in' operator, so assemblers takes ONE name and each
# assembler branch is gated on equality. The upstream SPADES ext.args
# '--${params.spades_mode}' is honored via config.spades_mode.
description = "De novo assembly with SPAdes (upstream SPADES, --{config.spades_mode})"
when = "!config.skip_assembly && config.assemblers == 'spades'"
shell = """
wd=$(pwd)
mkdir -p assembly/spades/rnaviral
# per-sample scratch: spades writes generic-named files and REFUSES to
# run in a directory holding a previous run's artifacts (live: the S1
# run littered the shared workdir and S2's spades died)
mkdir -p .tmp/spades_{sample} && cd .tmp/spades_{sample}
# --memory follows the machine's effective budget (live: 72 GB hardcoded
# is an OOM death sentence below that; the clamp cannot rescue a flag)
spades.py \\
    --{config.spades_mode} \\
    --threads {threads} \\
    --memory $(( {effective_memory_mb} / 1024 )) \\
    -1 "$wd/{input[0]}" \\
    -2 "$wd/{input[1]}" \\
    -o ./
# fail fast instead of silently exiting 0 on missing outputs (live:
# spades wrote nothing and the unguarded mv died) and emit the empty
# artifacts when the assembly is genuinely zero-contig
[ $? -eq 0 ] || { echo "spades.py failed for {sample}" 1>&2; exit 1; }
[ -f spades.log ] && mv spades.log "$wd/{output[3]}" || : > "$wd/{output[3]}"
if [ -f scaffolds.fasta ]; then
    mv scaffolds.fasta {sample}.scaffolds.fa
else
    : > {sample}.scaffolds.fa
fi
gzip -n {sample}.scaffolds.fa
mv {sample}.scaffolds.fa.gz "$wd/{output[0]}"
if [ -f contigs.fasta ]; then
    mv contigs.fasta {sample}.contigs.fa
else
    : > {sample}.contigs.fa
fi
gzip -n {sample}.contigs.fa
mv {sample}.contigs.fa.gz "$wd/{output[1]}"
if [ -f assembly_graph_with_scaffolds.gfa ]; then
    mv assembly_graph_with_scaffolds.gfa {sample}.assembly.gfa
else
    : > {sample}.assembly.gfa
fi
gzip -n {sample}.assembly.gfa
mv {sample}.assembly.gfa.gz "$wd/{output[2]}"
cd "$wd"
rm -rf .tmp/spades_{sample}
"""

[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

[rules.environment]
conda = "envs/spades.yaml"

[[rules]]
name = "bandage"
input = ["assembly/spades/rnaviral/{sample}.assembly.gfa.gz"]
output = [
    "assembly/spades/rnaviral/bandage/{sample}.png",
    "assembly/spades/rnaviral/bandage/{sample}.svg",
]
description = "Visualise the assembly graph with Bandage (upstream BANDAGE_IMAGE, with the upstream GUNZIP_GFA step merged in)"
when = "!config.skip_assembly && !config.skip_bandage && config.assemblers == 'spades'"
shell = """
mkdir -p assembly/spades/rnaviral/bandage
# Bandage 0.9.0 reads graphs with plain QFile and detects GFA by first-line
# content; a .gz input is binary and fails with 'Could not load graph'.
# Upstream therefore runs GUNZIP_GFA before BANDAGE_IMAGE.
gzip -cd {input[0]} > {sample}.assembly.gfa
Bandage image {sample}.assembly.gfa {output[0]} --height 1000
Bandage image {sample}.assembly.gfa {output[1]} --height 1000
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/bandage.yaml"

[[rules]]
name = "blast_assembly"
input = [
    "assembly/spades/rnaviral/{sample}.scaffolds.fa.gz",
    "reference/blastdb/genome.fa.nin",
    "reference/blastdb/genome.fa.nsq",
    "reference/blastdb/genome.fa.nhr",
    "scripts/blast_outfmt6_header.txt",
    "scripts/blast_filtered_outfmt6_header.txt",
]
output = [
    "assembly/spades/rnaviral/blastn/{sample}.results.blastn.txt",
    "assembly/spades/rnaviral/blastn/{sample}.filter.blastn.txt",
]
description = "BLAST the assembly scaffolds and filter hits (upstream BLAST_BLASTN + FILTER_BLASTN)"
when = "!config.skip_assembly && !config.skip_blast && config.assemblers == 'spades'"
shell = """
mkdir -p assembly/spades/rnaviral/blastn
gzip -c -d {input[0]} > {sample}.scaffolds.fa
DB=`find -L reference/blastdb -name "*.nin" | sed 's/\\.nin$//'`
[ -z "$DB" ] && DB=`find -L reference/blastdb -name "*.nal" | sed 's/\\.nal$//'`
echo Using $DB
blastn \\
    -num_threads {threads} \\
    -db $DB \\
    -query {sample}.scaffolds.fa \\
    -outfmt '6 stitle staxids std slen qlen qcovs' \\
    -out {sample}.blastn.txt
cat {input[4]} {sample}.blastn.txt > {output[0]}
awk 'BEGIN{OFS="\\t";FS="\\t"}{print $0,$6/$16,$6/$15}' {sample}.blastn.txt | awk 'BEGIN{OFS="\\t";FS="\\t"} $16 > {config.min_contig_length} && $18 > {config.min_perc_contig_aligned} && $1 !~ /phage/ {print $0}' > tmp.out
cat {input[5]} tmp.out > {output[1]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/blast.yaml"

[[rules]]
name = "quast_assembly"
input = ["assembly/spades/rnaviral/*.scaffolds.fa.gz", "reference/genome.fa", "reference/genome.gff"]
output = [
    "assembly/spades/rnaviral/quast.spades",
    "assembly/spades/rnaviral/quast.spades.tsv",
]
description = "Assembly QC with QUAST (upstream QUAST, assembly branch)"
when = "!config.skip_assembly && !config.skip_assembly_quast && config.assemblers == 'spades'"
depends_on = ["assemble_spades"]
shell = """
mkdir -p quast_inputs
for f in {input[0]}; do
    gzip -cd "$f" > "quast_inputs/$(basename "$f" .fa.gz).fa"
done
quast.py \\
    --output-dir {output[0]} \\
    -r {input[1]} \\
    --features {input[2]} \\
    --threads {threads} \\
    quast_inputs/*.fa
# a real copy, not a symlink: the engine's output validation does not
# accept symlinked outputs (live: the valid symlink still failed
# validation), and -f guards the resumption residue
rm -f {output[1]}
cp {output[0]}/report.tsv {output[1]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/quast.yaml"

[[rules]]
name = "abacas"
input = ["assembly/spades/rnaviral/{sample}.scaffolds.fa.gz", "reference/genome.fa"]
output = [
    "assembly/spades/rnaviral/abacas/{sample}.abacas.bin",
    "assembly/spades/rnaviral/abacas/{sample}.abacas.nucmer.delta",
    "assembly/spades/rnaviral/abacas/{sample}.abacas.nucmer.filtered.delta",
    "assembly/spades/rnaviral/abacas/{sample}.abacas.nucmer.tiling",
    "assembly/spades/rnaviral/abacas/{sample}.abacas.unused.contigs.out",
]
description = "Contiguate the assembly against the reference with ABACAS (upstream ABACAS)"
when = "!config.skip_assembly && !config.skip_abacas && config.assemblers == 'spades'"
shell = """
mkdir -p assembly/spades/rnaviral/abacas
gzip -cd {input[0]} > {sample}.scaffolds.fa
abacas.pl \\
    -r {input[1]} \\
    -q {sample}.scaffolds.fa \\
    -m -p nucmer \\
    -o {sample}.abacas
sort "{sample}.abacas.bin" > "{sample}.abacas.bin.tmp" && mv "{sample}.abacas.bin.tmp" "{sample}.abacas.bin"
mv {sample}.abacas.bin {output[0]}
mv nucmer.delta {output[1]}
mv nucmer.filtered.delta {output[2]}
mv nucmer.tiling {output[3]}
mv unused_contigs.out {output[4]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/abacas.yaml"

[[rules]]
name = "assemble_unicycler"
input = ["assembly/cutadapt/{sample}_1.trim.fastq.gz", "assembly/cutadapt/{sample}_2.trim.fastq.gz"]
output = [
    "assembly/unicycler/{sample}.scaffolds.fa.gz",
    "assembly/unicycler/{sample}.assembly.gfa.gz",
    "assembly/unicycler/{sample}.unicycler.log",
]
description = "De novo assembly with Unicycler (upstream UNICYCLER, process_high label)"
when = "!config.skip_assembly && config.assemblers == 'unicycler'"
shell = """
wd=$(pwd)
mkdir -p assembly/unicycler
# per-sample scratch: unicycler writes generic-named files in its workdir
mkdir -p .tmp/unicycler_{sample} && cd .tmp/unicycler_{sample}
unicycler \\
    --threads {threads} \\
    -1 "$wd/{input[0]}" \\
    -2 "$wd/{input[1]}" \\
    --out ./
[ $? -eq 0 ] || { echo "unicycler failed for {sample}" 1>&2; exit 1; }
# upstream filters empty scaffolds/gfa out of the channels; the port emits
# empty artifacts instead (documented runtime-filter deviation)
[ -f assembly.fasta ] && mv assembly.fasta {sample}.scaffolds.fa || : > {sample}.scaffolds.fa
gzip -n {sample}.scaffolds.fa
mv {sample}.scaffolds.fa.gz "$wd/{output[0]}"
[ -f assembly.gfa ] && mv assembly.gfa {sample}.assembly.gfa || : > {sample}.assembly.gfa
gzip -n {sample}.assembly.gfa
mv {sample}.assembly.gfa.gz "$wd/{output[1]}"
[ -f unicycler.log ] && mv unicycler.log {sample}.unicycler.log || : > {sample}.unicycler.log
mv {sample}.unicycler.log "$wd/{output[2]}"
cd "$wd"
rm -rf .tmp/unicycler_{sample}
"""

[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

[rules.environment]
conda = "envs/unicycler.yaml"

[[rules]]
name = "bandage_unicycler"
input = ["assembly/unicycler/{sample}.assembly.gfa.gz"]
output = [
    "assembly/unicycler/bandage/{sample}.png",
    "assembly/unicycler/bandage/{sample}.svg",
