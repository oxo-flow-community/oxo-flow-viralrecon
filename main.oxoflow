mv unused_contigs.out {output[4]}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/abacas.yaml"

[[rules]]
name = "assemble_minia"
input = ["assembly/cutadapt/{sample}_1.trim.fastq.gz", "assembly/cutadapt/{sample}_2.trim.fastq.gz"]
output = [
    "assembly/minia/{sample}.contigs.fa",
    "assembly/minia/{sample}.unitigs.fa",
    "assembly/minia/{sample}.h5",
]
description = "De novo assembly with minia (upstream MINIA, process_high label)"
when = "!config.skip_assembly && config.assemblers == 'minia'"
shell = """
mkdir -p assembly/minia
# minia reads a list of input files (upstream module: reads joined by ',')
echo "{input[0]}" > input_files.txt
echo "{input[1]}" >> input_files.txt
minia \\
    -kmer-size 31 -abundance-min 20 \\
    -nb-cores {threads} \\
    -in input_files.txt \\
    -out {sample}
[ $? -eq 0 ] || { echo "minia failed for {sample}" 1>&2; exit 1; }
# upstream filters empty contig files out of the channels; the port emits
# empty artifacts instead (documented runtime-filter deviation)
[ -f {sample}.contigs.fa ] || : > {sample}.contigs.fa
mv {sample}.contigs.fa {output[0]}
mv {sample}.unitigs.fa {output[1]}
mv {sample}.h5 {output[2]}
"""

[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

[rules.environment]
conda = "envs/minia.yaml"

