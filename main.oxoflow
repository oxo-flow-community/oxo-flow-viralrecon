gzip -cd {input[0]} > {sample}.scaffolds.fa
abacas.pl \\
    -r {input[1]} \\
    -q {sample}.scaffolds.fa \\
    -m -p nucmer \\
    -o {sample}.abacas
sort "{sample}.abacas.bin" > "{sample}.abacas.bin.tmp" && mv "{sample}.abacas.bin.tmp" "{sample}.abacas.bin"
mv {sample}.abacas.bin {output[0]}
mv nucmer.delta {output[1]}
mv nucmer.filtered.delta {output[2]}
